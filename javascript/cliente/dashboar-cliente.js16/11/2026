window.mostrarToast = function (mensaje, tipo = 'info', duracion = 3000) {
    const colores = {
        success: '#00ff88',
        error: '#ff4444',
        warning: '#ffbb33',
        info: '#00d4ff'
    };

    const iconos = {
        success: '✅',
        error: '❌',
        warning: '⚠️',
        info: 'ℹ️'
    };

    const toast = document.createElement('div');
    toast.className = 'toast-notification';
    toast.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: #131c2b;
        border-left: 4px solid ${colores[tipo]};
        color: white;
        padding: 15px 20px;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        z-index: 100000;
        min-width: 300px;
        max-width: 400px;
        transform: translateX(120%);
        transition: transform 0.3s ease;
        font-family: 'Inter', sans-serif;
        display: flex;
        align-items: center;
        gap: 10px;
        animation: slideIn 0.3s ease forwards, fadeOut 0.3s ease ${duracion - 300}ms forwards;
    `;

    toast.innerHTML = `
        <span style="font-size: 1.2rem;">${iconos[tipo]}</span>
        <span style="flex: 1; font-size: 0.9rem;">${mensaje}</span>
        <button onclick="this.parentElement.remove()" style="background: none; border: none; color: #888; cursor: pointer; font-size: 1.2rem;">×</button>
    `;

    if (!document.getElementById('toast-styles')) {
        const style = document.createElement('style');
        style.id = 'toast-styles';
        style.textContent = `
            @keyframes slideIn {
                to { transform: translateX(0); }
            }
            @keyframes fadeOut {
                to { opacity: 0; transform: translateX(120%); }
            }
        `;
        document.head.appendChild(style);
    }

    document.body.appendChild(toast);

    setTimeout(() => {
        if (toast.parentElement) {
            toast.remove();
        }
    }, duracion);
};

