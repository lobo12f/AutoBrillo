// ============================================================================
async function cargarTalleresEnSelect(tallerPreseleccionado) {
    const select = document.getElementById('cita-sucursal');
    if (!select) return;

    select.innerHTML = '<option value="" disabled selected>🔍 Buscando talleres...</option>';

    try {
        let talleres = await window.clienteTallerService.obtenerTalleresDisponibles();

        // ⭐ Filtrar solo con bahías disponibles
        talleres = talleres.filter(t => (t.bahiasDisponibles || 0) > 0);

        // ⭐ Agrupar por nombre+ciudad para evitar duplicados masivos
        const mapa = new Map();
        talleres.forEach(t => {
            const key = `${t.nombre}|${t.direccion?.ciudad || ''}`;
            if (!mapa.has(key)) {
                mapa.set(key, t);
            } else {
                const actual = mapa.get(key);
                if ((t.bahiasDisponibles || 0) > (actual.bahiasDisponibles || 0)) {
                    mapa.set(key, t);
                }
            }
        });

        talleresDisponibles = [...mapa.values()];

        if (talleresDisponibles.length === 0) {
            select.innerHTML = '<option value="" disabled>No hay talleres con disponibilidad</option>';
            return;
        }

        select.innerHTML = '<option value="" disabled selected>Selecciona un taller...</option>';

        talleresDisponibles.forEach(taller => {
            const option = document.createElement('option');
            option.value = taller._id;
            option.textContent = `${taller.nombre} - ${taller.direccion?.ciudad || ''} (${taller.bahiasDisponibles} bahías)`;
            select.appendChild(option);
        });

        if (tallerPreseleccionado) {
            select.value = tallerPreseleccionado;
            window.alSeleccionarTaller(tallerPreseleccionado);
        }
    } catch (error) {
        console.error('Error cargando talleres:', error);
        select.innerHTML = '<option value="" disabled>Error al cargar talleres</option>';
    }
}

