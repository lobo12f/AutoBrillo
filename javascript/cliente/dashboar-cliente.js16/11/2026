async function cargarServiciosDelTaller(tallerId, mostrarToast = true) {
    const contenedor = document.getElementById('mc-servicios-lista');
    if (!contenedor) return;

    contenedor.innerHTML = '<p class="mc-empty">⏳ Cargando servicios...</p>';

    try {
        const response = await apiFetch(`/talleres/${tallerId}/servicios`);
        const data = await response.json();

        if (data.exito && data.servicios && data.servicios.length > 0) {
            const servicios = data.servicios.filter(s => s.activo !== false);
            renderizarListaServicios(servicios);
        } else {
            // Fallback con servicios por defecto
            renderizarListaServicios([
                { nombre: 'Lavado Básico', precio: 500, duracionEstimada: 30, descripcion: 'Lavado exterior + secado', tipo: 'LAVADO' },
                { nombre: 'Lavado Premium', precio: 1200, duracionEstimada: 60, descripcion: 'Lavado completo + aspirado', tipo: 'LAVADO' },
                { nombre: 'Detallado Interior', precio: 2500, duracionEstimada: 90, descripcion: 'Limpieza profunda de interiores', tipo: 'DETALLADO' },
                { nombre: 'Pulido Completo', precio: 3500, duracionEstimada: 120, descripcion: 'Pulido y encerado profesional', tipo: 'PULIDO' }
            ]);
        }
    } catch (error) {
        console.error('Error cargando servicios:', error);
        contenedor.innerHTML = '<p class="mc-empty">Error al cargar servicios</p>';
    }
}

function renderizarListaServicios(servicios) {
