// ==================== SISTEMA DE CACHE ====================
const cache = new Map();

window.obtenerConCache = async function (clave, funcionFetch, ttl = CACHE_TTL) {
    const cached = cache.get(clave);

    if (cached && (Date.now() - cached.timestamp) < ttl) {
        logger.debug(`Cache hit: ${clave}`);
        return cached.data;
    }

    logger.debug(`Cache miss: ${clave}, fetching...`);

    try {
        const data = await funcionFetch();
        cache.set(clave, { data, timestamp: Date.now() });
        return data;
    } catch (error) {
        logger.error(`Error fetching ${clave}:`, error);
        if (cached) {
            logger.warn(`Usando cache expirado como fallback: ${clave}`);
            return cached.data;
        }
        throw error;
    }
};

window.limpiarCache = function () {
    cache.clear();
    logger.info('Cache limpiado');
};

