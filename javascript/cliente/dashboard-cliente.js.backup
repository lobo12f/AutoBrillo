// ==================== INICIO DEL DASHBOARD ====================

document.addEventListener("DOMContentLoaded", async function () {
    logger.info('🚀 Inicializando dashboard del cliente...');


    const sesionData = db.obtenerSesion();
    if (!sesionData) {
        window.location.href = "login.html";
        return;
    }

    try {
        // Inicializar cliente (la clase Cliente maneja sus propiedades privadas)
        window.user = new Cliente(sesionData);
        window.calificacionesManager = new CalificacionesManager(API_BASE_URL);
        window.resenasSocial = new ResenasSocialManager(API_BASE_URL);
        window.galeriaTrabajos = new GaleriaTrabajos(API_BASE_URL);
        window.galeriaTaller = new GaleriaTaller(API_BASE_URL);
        window.mapaTaller = new MapaTaller();


        logger.info('✅ Sistema listo. ID de usuario:', window.user.id);

        // Inicializar wallet
        window.wallet = new Wallet(window.user);
        // ================================================================
        // 🔌 CONECTAR WEBSOCKET DEL CLIENTE
        // ================================================================
        const clienteId = window.user._id || window.user.id;
        if (clienteId) {
            conectarWebSocketCliente(clienteId, {
                // ============================================================
                // 🔔 CAMBIOS DE ESTADO DE CITAS
                // ============================================================
                onCambioEstadoCita: (data) => {
                    console.log('📡 Cambio de estado recibido:', data);
                    window.mostrarToast(data.mensaje || 'Estado actualizado', 'info');

                    // Recargar citas desde el servidor
                    if (typeof window.sincronizarEstadoCitas === 'function') {
                        window.sincronizarEstadoCitas();
                    }

                    // Reproducir sonido si es "LISTO"
                    if (data.estado === 'LISTO') {
                        try {
                            const audio = new Audio('data:audio/wav;base64,');
                            audio.volume = 0.3;
                            audio.play().catch(() => { });
                        } catch (e) { }
                    }
                },

                // ============================================================
                // 🔔 NOTIFICACIONES
                // ============================================================
                onNotificacion: (data) => {
                    console.log('🔔 Notificación recibida:', data);
                    window.mostrarToast(data.mensaje || 'Notificación', 'info');

                    // Guardar en localStorage
                    const notificaciones = JSON.parse(localStorage.getItem('notificaciones_clientes') || '[]');
                    notificaciones.push({
                        tipo: data.tipo || 'OTRO',
                        citaId: data.citaId,
                        mensaje: data.mensaje,
                        fecha: new Date().toISOString(),
                        leida: false
                    });
                    localStorage.setItem('notificaciones_clientes', JSON.stringify(notificaciones));

                    // Actualizar badge
                    if (typeof window.cargarNotificaciones === 'function') {
                        window.cargarNotificaciones();
                    }
                },

                // ============================================================
                // 🔄 PERFIL ACTUALIZADO
                // ============================================================
                onPerfilActualizado: (cambios) => {
                    console.log('👤 Perfil actualizado:', cambios);
                    if (cambios.fotoPerfil && window.user) {
                        window.user.fotoPerfil = cambios.fotoPerfil;
                        window.persistirUsuario();
                        window.actualizarInterfaz(window.user);
                    }
                }
            });
        }

        // ✅ Inicializar TallerVinculadoManager (DENTRO del try)
        window.tallerManager = new TallerVinculadoManager(API_BASE_URL);
        await window.tallerManager.init();

        // Escuchar cambios de taller
        window.tallerManager.on('tallerVinculado', (taller) => {
            console.log('🎉 Taller vinculado:', taller.nombre);
            window.actualizarInterfaz(window.user);
        });

        window.tallerManager.on('tallerDesvinculado', () => {
            console.log('🔓 Taller desvinculado');
            window.renderizarPlanes?.();
        });

        // Cargar datos iniciales
        await window.sincronizarEstadoCitas();
        window.actualizarInterfaz(window.user);
        window.inicializarMarcas();

        // ✅ Si hay taller vinculado, cargar sus planes; si no, mostrar selector
        if (window.tallerManager.tieneTallerVinculado()) {
            await window.tallerManager.actualizarPlanes();
        } else {
            window.renderizarPlanes();
        }

        window.cargarNotificaciones();

        // Configurar actualización periódica
        window.iniciarSincronizacion();

        // Renderizado inicial
        if (typeof window.renderizarCitas === 'function') {
            window.renderizarCitas();
        }

        // Sincronización con servidor
        await db.sincronizarConServidor();

        logger.info('✅ Dashboard inicializado correctamente');

    } catch (error) {
        logger.error('❌ Error crítico en inicio:', error);
        console.error('Stack trace:', error.stack);
        window.mostrarToast('Error al cargar el dashboard. Recarga la página.', 'error', 5000);
    }

    // Event listener para búsqueda (fuera del try porque no son críticos)
    document.getElementById('busqueda-placa')?.addEventListener('input', (e) => {
        window.filtroActualPlaca = e.target.value;
        if (typeof window.renderizarGaleria === 'function') window.renderizarGaleria();
    });

    document.getElementById('filtro-modelo')?.addEventListener('change', () => {
        if (typeof window.renderizarGaleria === 'function') window.renderizarGaleria();
    });

    // Configurar evento para cambio de foto de vehículo
    const inputFotoAuto = document.getElementById('input-cambiar-foto-auto');
    if (inputFotoAuto) {
        inputFotoAuto.addEventListener('change', window.confirmarCambioFotoAuto);
    }
});

// ==================== SINCRONIZACIÓN MEJORADA ====================
window.iniciarSincronizacion = function () {
    if (intervaloActual) {
        clearInterval(intervaloActual);
    }

    intervaloActual = setInterval(async () => {
        try {
            await window.sincronizarEstadoCitas();
            window.cargarNotificaciones();
            logger.debug('Sincronización periódica completada');
        } catch (error) {
            logger.error('Error en sincronización periódica:', error);
        }
    }, SYNC_INTERVAL);

    logger.info('Sincronización periódica iniciada');
};

window.detenerSincronizacion = function () {
    if (intervaloActual) {
        clearInterval(intervaloActual);
        intervaloActual = null;
        logger.info('Sincronización periódica detenida');
    }
};

window.addEventListener('beforeunload', () => {
    window.detenerSincronizacion();
    logger.info('Dashboard cerrado');
});

// ==================== FUNCIONES DE INTERFAZ ====================

window.actualizarInterfaz = function (instanciaCliente) {
    const user = instanciaCliente || window.user;
    if (!user) return;

    logger.debug('Actualizando interfaz para usuario:', user.nombre);

    // --- IDENTIDAD ---
    const fotoURL = user.fotoPerfil || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.nombre)}&background=0b0f19&color=00ff88`;
    document.querySelectorAll('#user-name, #display-nombre, #user-name-display').forEach(el => el.innerText = user.nombre);
    document.querySelectorAll('#foto-perfil-grande, #avatar-sidebar').forEach(img => img.src = fotoURL);
    if (document.getElementById('display-email')) document.getElementById('display-email').innerText = user.email;

    // --- WALLET Y SERVICIOS (usando getters) ---
    if (document.getElementById('saldo-cuenta')) {
        document.getElementById('saldo-cuenta').innerText = `RD$ ${user.saldo.toFixed(2)}`;
    }

    const elServicios = document.getElementById('servicios-qty');
    if (elServicios) {
        const servicios = user.serviciosDisponibles;
        elServicios.innerText = servicios;
        elServicios.style.color = servicios > 0 ? "#00ff88" : "#ff4444";
    }

    // --- PLAN ---
    const elPlanTexto = document.getElementById('plan-actual-texto');
    const badgePlan = document.getElementById('badge-plan');
    const planActual = user.planActual;
    if (elPlanTexto) {
        elPlanTexto.innerText = planActual !== "Ninguno" ? `Plan Activo: ${planActual}` : "Sin plan activo";
        elPlanTexto.style.color = planActual !== "Ninguno" ? "#00ff88" : "#ffbb33";
    }
    if (badgePlan) badgePlan.innerText = `Plan: ${planActual}`;

    // --- CONTADORES (usando getters) ---
    const garaje = user.garaje;
    const misCitas = user.misCitas;

    if (document.getElementById('qty-autos')) {
        document.getElementById('qty-autos').innerText = garaje.length;
    }

    // --- MINI ESTADÍSTICAS ---
    if (document.getElementById('user-total-citas')) {
        document.getElementById('user-total-citas').textContent = misCitas.length;
    }
    if (document.getElementById('user-vehiculos')) {
        document.getElementById('user-vehiculos').textContent = garaje.length;
    }
    if (document.getElementById('user-antiguedad')) {
        if (user.fechaRegistro) {
            const fecha = new Date(user.fechaRegistro);
            const ahora = new Date();
            const meses = (ahora.getFullYear() - fecha.getFullYear()) * 12 + (ahora.getMonth() - fecha.getMonth());
            document.getElementById('user-antiguedad').textContent = meses < 1 ? 'Nuevo' : meses;
        } else {
            document.getElementById('user-antiguedad').textContent = '-';
        }
    }

    // --- CONTADOR DEL GARAJE ---
    if (document.getElementById('garage-count')) {
        document.getElementById('garage-count').textContent = garaje.length + ' vehículo' + (garaje.length !== 1 ? 's' : '');
    }

    // --- RENDERIZAR GARAJE ---
    if (typeof window.renderizarGaraje === 'function') {
        window.renderizarGaraje();
    }

    // --- PRÓXIMA CITA ---
    const elProxima = document.getElementById('proxima-cita');
    const elSucursalCita = document.getElementById('sucursal-cita');
    if (elProxima) {
        const citasPendientes = misCitas.filter(c =>
            ESTADOS_PENDIENTES.includes(c.estado?.toUpperCase())
        );
        if (citasPendientes.length > 0) {
            const citasOrdenadas = [...citasPendientes].sort((a, b) => new Date(a.fecha) - new Date(b.fecha));
            const cita = citasOrdenadas[0];
            elProxima.innerText = `${cita.fecha} | ${cita.hora}`;
            elProxima.style.color = "#00ff88";
            if (elSucursalCita) elSucursalCita.innerText = `📍 ${cita.sucursal}`;
        } else {
            elProxima.innerText = "No hay citas";
            elProxima.style.color = "#888";
            if (elSucursalCita) elSucursalCita.innerText = "Reserva tu espacio ahora";
        }
    }
    if (window.tallerManager?.tieneTallerVinculado()) {
        document.getElementById('badge-plan').textContent = `🏪 ${window.tallerManager.getTaller().nombre}`;
    }
};

// ==================== MARCAS Y MODELOS ====================

window.inicializarMarcas = function () {
    const selectMarca = document.getElementById('car-marca');
    if (!selectMarca) return;
    selectMarca.innerHTML = '<option value="" disabled selected>Selecciona una marca...</option>';
    const marcas = Object.keys(CATALOGO_VEHICULOS).sort();
    marcas.forEach(marca => {
        const opt = document.createElement('option');
        opt.value = marca;
        opt.textContent = marca;
        selectMarca.appendChild(opt);
    });
};

window.actualizarModelos = function () {
    const elMarca = document.getElementById('car-marca');
    const elModelo = document.getElementById('car-modelo');
    if (!elMarca || !elModelo) return;
    const marcaElegida = elMarca.value;
    elModelo.innerHTML = '<option value="" disabled selected>Selecciona un modelo...</option>';
    if (CATALOGO_VEHICULOS[marcaElegida]) {
        elModelo.disabled = false;
        CATALOGO_VEHICULOS[marcaElegida].sort().forEach(modelo => {
            const opt = document.createElement('option');
            opt.value = modelo;
            opt.textContent = modelo;
            elModelo.appendChild(opt);
        });
    } else {
        elModelo.disabled = true;
    }
};

// ==================== GESTIÓN DE VEHÍCULOS (USANDO MÉTODOS DE CLASE) ====================

window.renderizarGaraje = function () {
    const container = document.getElementById('contenedor-vehiculos');
    if (!container || !window.user) return;

    container.innerHTML = '';

    const garaje = window.user.garaje || [];

    const countEl = document.getElementById('garage-count');
    if (countEl) {
        countEl.textContent = garaje.length + ' vehículo' + (garaje.length !== 1 ? 's' : '');
    }

    if (garaje.length === 0) {
        container.innerHTML = `
            <div class="empty-garage">
                <div class="empty-garage-icon">🚙</div>
                <p>No tienes vehículos registrados</p>
                <button class="btn-add-first-car" onclick="window.abrirModalVehiculo()">
                    + Registrar mi primer vehículo
                </button>
            </div>`;
        return;
    }

    garaje.forEach(auto => {
        const id = auto.id || auto._id;
        const tieneFoto = auto.foto && (auto.foto.startsWith('data:image') || auto.foto.startsWith('http'));
        const fotoUrl = tieneFoto ? auto.foto : 'https://via.placeholder.com/400x250/131c2b/00ff88?text=Sin+Foto';

        const card = document.createElement('div');
        card.className = 'car-card';
        card.innerHTML = `
            <div class="car-card-body" onclick="window.agendarCitaConVehiculo('${id}')">
                <div class="car-image-wrapper">
                    ${tieneFoto
                ? `<img src="${fotoUrl}" alt="${auto.marca || 'Vehículo'}" class="car-img" />`
                : `<div class="car-img-fallback">🚗</div>`
            }
                    ${auto.color ? `
                    <div class="car-color-badge" title="Color: ${auto.color}">
                        <span class="car-color-dot" style="background-color: ${auto.color};"></span>
                    </div>` : ''}
                </div>

                <div class="car-details">
                    <div class="car-header-info">
                        <h4>${auto.marca || 'Vehículo'} ${auto.modelo || ''}</h4>
                        <span class="car-plate">${auto.placa || 'S/P'}</span>
                    </div>
                    <p class="car-action-hint">Haz clic para agendar cita ⚡</p>
                </div>
            </div>

            <div class="car-actions">
                <button type="button" class="btn-car-action" title="Cambiar foto" onclick="event.stopPropagation(); window.dispararCambioFotoAuto('${id}')">📷</button>
                <button type="button" class="btn-car-action" title="Editar vehículo" onclick="event.stopPropagation(); window.editarVehiculo('${id}')">✏️</button>
                <button type="button" class="btn-car-action delete" title="Eliminar vehículo" onclick="event.stopPropagation(); window.eliminarVehiculo('${id}')">🗑️</button>
            </div>
        `;
        container.appendChild(card);
    });

    if (document.getElementById('qty-autos')) {
        document.getElementById('qty-autos').textContent = garaje.length;
    }
    if (document.getElementById('user-vehiculos')) {
        document.getElementById('user-vehiculos').textContent = garaje.length;
    }
};

window.abrirModalVehiculo = function () {
    const modal = document.getElementById('modal-vehiculo');
    if (!modal) {
        logger.error('❌ No se encontró el modal de vehículo');
        return;
    }

    document.getElementById('car-marca').value = '';
    document.getElementById('car-modelo').innerHTML = '<option value="" disabled selected>Primero selecciona una marca...</option>';
    document.getElementById('car-modelo').disabled = true;
    document.getElementById('car-placa').value = '';
    document.getElementById('car-color').value = '#33d17a';
    document.getElementById('car-foto').value = '';

    modal.querySelector('h3').textContent = 'Registrar Nuevo Vehículo';
    modal.querySelector('button[type="submit"]').textContent = 'AÑADIR AL GARAJE';
    modal.setAttribute('data-editando', '');

    window.inicializarMarcas();
    modal.style.display = 'flex';
};

window.editarVehiculo = function (id) {
    const garaje = window.user.garaje; // Getter
    const vehiculo = garaje.find(v => (v.id || v._id) == id);
    if (!vehiculo) {
        window.mostrarToast('⚠️ Vehículo no encontrado', 'warning');
        return;
    }

    const modal = document.getElementById('modal-vehiculo');
    if (!modal) return;

    window.inicializarMarcas();

    setTimeout(() => {
        document.getElementById('car-marca').value = vehiculo.marca || '';
        window.actualizarModelos();

        setTimeout(() => {
            document.getElementById('car-modelo').value = vehiculo.modelo || '';
        }, 200);

        document.getElementById('car-placa').value = vehiculo.placa || '';
        document.getElementById('car-color').value = vehiculo.color || '#33d17a';
        document.getElementById('car-foto').value = '';

        modal.querySelector('h3').textContent = 'Editar Vehículo';
        modal.querySelector('button[type="submit"]').textContent = '💾 GUARDAR CAMBIOS';
        modal.setAttribute('data-editando', id);

        modal.style.display = 'flex';
    }, 300);
};

window.añadirVehiculo = async function (event) {
    if (event) event.preventDefault();

    const modal = document.getElementById('modal-vehiculo');
    const editandoId = modal?.getAttribute('data-editando');

    const marca = document.getElementById('car-marca')?.value;
    const modelo = document.getElementById('car-modelo')?.value;
    const placa = document.getElementById('car-placa')?.value.trim();
    const color = document.getElementById('car-color')?.value;
    const fotoInput = document.getElementById('car-foto');

    if (!marca || !modelo || !placa) {
        window.mostrarToast('⚠️ Completa todos los campos obligatorios', 'warning');
        return;
    }

    if (!validadores.placa(placa)) {
        window.mostrarToast('⚠️ La placa debe tener entre 5 y 8 caracteres alfanuméricos', 'warning');
        return;
    }

    window.estadoCarga.mostrar('Guardando vehículo...');

    let fotoUrl = null;
    if (fotoInput && fotoInput.files && fotoInput.files[0]) {
        if (fotoInput.files[0].size > 5 * 1024 * 1024) {
            window.mostrarToast('⚠️ La imagen es muy grande. Máximo 5MB.', 'warning');
            window.estadoCarga.ocultar();
            return;
        }

        try {
            const formData = new FormData();
            formData.append('imagen', fotoInput.files[0]);

            const data = await window.fetchConReintento(`/upload/imagen`, {
                method: 'POST',
                body: formData
            });

            if (data.exito) {
                fotoUrl = data.url;
                logger.info('📷 Imagen subida:', fotoUrl);
            }
        } catch (error) {
            logger.error('❌ Error al subir imagen:', error);
            window.mostrarToast('⚠️ No se pudo subir la foto. Continuará sin foto.', 'warning');
        }
    }

    const vehiculoData = {
        marca,
        modelo,
        placa: placa.toUpperCase(),
        color,
        foto: fotoUrl
    };

    try {
        if (editandoId) {
            // EDITAR usando método de la clase
            const actualizado = window.user.actualizarVehiculo(editandoId, vehiculoData);
            if (actualizado) {
                window.mostrarToast('✅ Vehículo actualizado correctamente', 'success');
            }
        } else {
            // NUEVO usando método de la clase
            const agregado = window.user.agregarVehiculo(vehiculoData);
            if (agregado) {
                window.mostrarToast('✅ Vehículo agregado al garaje', 'success');
            } else {
                window.mostrarToast('⚠️ Ya existe un vehículo con esa placa', 'warning');
            }
        }

        window.persistirUsuario();
        modal.style.display = 'none';
        window.renderizarGaraje();
        window.actualizarInterfaz(window.user);

        if (window.db && window.db.sincronizarConServidor) {
            await window.db.sincronizarConServidor();
        }
    } catch (error) {
        logger.error('Error al guardar vehículo:', error);
        window.mostrarToast('❌ Error al guardar el vehículo', 'error');
    } finally {
        window.estadoCarga.ocultar();
    }
};

window.eliminarVehiculo = function (id) {
    if (!confirm('¿Estás seguro de eliminar este vehículo? Esta acción no se puede deshacer.')) return;

    const garaje = window.user.garaje;
    const vehiculo = garaje.find(v => (v.id || v._id) == id);

    if (!vehiculo) {
        window.mostrarToast('⚠️ Vehículo no encontrado.', 'warning');
        return;
    }

    const eliminado = window.user.eliminarVehiculo(id);
    if (eliminado) {
        window.persistirUsuario();
        window.renderizarGaraje();
        window.actualizarInterfaz(window.user);
        window.mostrarToast(`🗑️ Vehículo ${vehiculo.marca} eliminado`, 'success');

        if (window.db && window.db.sincronizarConServidor) {
            window.db.sincronizarConServidor();
        }
    }
};

window.dispararCambioFotoAuto = function (id) {
    const input = document.getElementById('input-cambiar-foto-auto');
    if (input) {
        input.setAttribute('data-vehiculo-id', id);
        input.click();
    }
};

window.confirmarCambioFotoAuto = async function (event) {
    const file = event.target.files[0];
    if (!file) return;

    const id = event.target.getAttribute('data-vehiculo-id');
    if (!id) return;

    if (file.size > 5 * 1024 * 1024) {
        window.mostrarToast('⚠️ La imagen es muy grande. Máximo 5MB.', 'warning');
        return;
    }

    window.estadoCarga.mostrar('Subiendo foto...');

    try {
        const formData = new FormData();
        formData.append('imagen', file);

        const data = await window.fetchConReintento(`/upload/imagen`, {
            method: 'POST',
            body: formData
        });

        if (data.exito) {
            window.user.actualizarVehiculo(id, { foto: data.url });
            window.persistirUsuario();
            window.renderizarGaraje();
            window.mostrarToast('✅ Foto actualizada', 'success');
        } else {
            window.mostrarToast('❌ Error al subir la foto.', 'error');
        }
    } catch (error) {
        logger.error('Error al cambiar foto:', error);
        window.mostrarToast('❌ Error de conexión al subir la foto.', 'error');
    } finally {
        window.estadoCarga.ocultar();
    }

    event.target.value = '';
};

window.cerrarModalVehiculo = function () {
    const modal = document.getElementById('modal-vehiculo');
    if (modal) modal.style.display = 'none';
};

// ==================== RECARGA DE SALDO ====================

window.abrirRecarga = function () {
    if (!window.user) {
        window.mostrarToast("⚠️ Debes iniciar sesión.", "warning");
        return;
    }
    const modal = document.getElementById('modal-recarga');
    const displayNombre = document.getElementById('recarga-usuario-nombre');
    const inputMonto = document.getElementById('monto-recarga');
    if (modal) {
        if (displayNombre) displayNombre.textContent = window.user.nombre;
        if (inputMonto) inputMonto.value = "";
        modal.style.display = 'flex';
    }
};

window.procesarRecarga = async function (e) {
    if (e) e.preventDefault();
    const inputMonto = document.getElementById('monto-recarga');
    const monto = parseFloat(inputMonto.value);

    if (isNaN(monto) || monto <= 0) {
        window.mostrarToast("⚠️ Ingresa un monto válido.", "warning");
        return;
    }

    if (monto < 50) {
        window.mostrarToast("⚠️ El monto mínimo de recarga es RD$ 50.00", "warning");
        return;
    }

    window.estadoCarga.mostrar('Procesando recarga...');

    const saldoActual = window.user.saldo;
    window.user.saldo = saldoActual + monto; // Usa el setter de la clase

    try {
        const exito = await window.db.sincronizarConServidor();
        if (exito) {
            window.persistirUsuario();
            const displaySaldo = document.getElementById('saldo-cuenta');
            if (displaySaldo) displaySaldo.textContent = window.user.saldo.toFixed(2);
            window.mostrarToast(`✅ Recarga exitosa. Tu nuevo saldo es: RD$ ${window.user.saldo.toFixed(2)}`, 'success');
            inputMonto.value = "";
            window.cerrarModales();
        } else {
            window.user.saldo = saldoActual; // Revertir
            window.mostrarToast("❌ Error al sincronizar.", "error");
        }
    } catch (error) {
        logger.error('Error en recarga:', error);
        window.user.saldo = saldoActual; // Revertir
        window.mostrarToast("❌ Error de conexión.", "error");
    } finally {
        window.estadoCarga.ocultar();
    }
};

// ==================== MODALES ====================

window.cerrarModales = function () {
    document.querySelectorAll('.modal').forEach(modal => {
        modal.style.display = 'none';
        modal.classList.remove('active', 'show');
    });
    ['modal-recarga', 'modal-vehiculo', 'modal-cita', 'modal-notificaciones'].forEach(id => {
        const m = document.getElementById(id);
        if (m) m.style.display = 'none';
    });
    document.querySelectorAll('form').forEach(f => f.reset());
};

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
        window.cerrarModales();
    }
});

document.addEventListener('click', function (e) {
    if (e.target.classList.contains('modal')) {
        window.cerrarModales();
    }
});

// ==================== PLANES ====================

window.renderizarPlanes = async function () {
    // Si hay taller vinculado, delegar al manager
    if (window.tallerManager?.tieneTallerVinculado()) {
        await window.tallerManager.actualizarPlanes();
        return;
    }

    // Si no hay taller vinculado, mostrar mensaje para seleccionar
    const contenedor = document.getElementById('contenedor-planes-cards');
    if (!contenedor) return;

    contenedor.innerHTML = `
        <div style="grid-column:1/-1; text-align:center; padding:40px; color:#888;">
            <span style="font-size:4rem;">🏪</span>
            <h3 style="color:#fff; margin:15px 0;">Selecciona tu taller de confianza</h3>
            <p style="margin-bottom:20px;">Vincula un taller para ver sus planes exclusivos</p>
            <button onclick="window.tallerManager.mostrarSelector()" 
                style="padding:14px 30px; background:#00ff88; color:#000; border:none; border-radius:10px; cursor:pointer; font-weight:700; font-size:1rem;">
                🏪 Seleccionar Mi Taller
            </button>
        </div>`;
};

window.comprarPlanWeb = async function (planId, tallerId) {
    if (!confirm('¿Deseas comprar este plan? Se descontará de tu saldo.')) return;

    try {
        // Obtener datos del plan
        const response = await apiFetch(`/talleres/${tallerId}/planes`);
        const data = await response.json();
        const plan = data.planes?.find(p => p._id === planId);

        if (!plan) {
            window.mostrarToast('❌ Plan no encontrado', 'error');
            return;
        }

        if (window.user.saldo < plan.precio) {
            window.mostrarToast(`⚠️ Saldo insuficiente. Necesitas RD$ ${plan.precio.toLocaleString()}`, 'warning');
            return;
        }

        // Descontar saldo y activar plan
        window.user.saldo -= plan.precio;
        window.user.planActual = plan.nombre;
        window.user.serviciosDisponibles = plan.serviciosIncluidos;

        window.persistirUsuario();
        window.actualizarInterfaz(window.user);
        window.renderizarPlanes();

        window.mostrarToast(`✅ ¡Plan ${plan.nombre} activado! ${plan.serviciosIncluidos} servicios disponibles.`, 'success');

    } catch (error) {
        window.mostrarToast('❌ Error al comprar plan', 'error');
    }
};

// ==================== MODAL DE CITAS ====================

window.abrirModalSolicitud = async function (sucursalSeleccionada) {
    const garaje = window.user.garaje;
    if (garaje.length === 0) {
        window.mostrarToast("⚠️ No tienes vehículos registrados. Registra uno primero.", "warning");
        return;
    }

    window.actualizarSelectVehiculos();

    if (document.getElementById('cita-fecha')) {
        document.getElementById('cita-fecha').value = "";
        document.getElementById('cita-fecha').setAttribute('min', new Date().toISOString().split('T')[0]);
    }
    if (document.getElementById('cita-hora')) {
        document.getElementById('cita-hora').innerHTML = '<option value="" disabled selected>Primero selecciona fecha</option>';
    }
    if (document.getElementById('cita-servicio')) {
        document.getElementById('cita-servicio').value = "";
    }

    document.getElementById('disponibilidad-info').textContent = '';
    document.getElementById('taller-info').style.display = 'none';

    await cargarTalleresEnSelect(sucursalSeleccionada);

    const modal = document.getElementById('modal-cita');
    if (modal) {
        modal.style.display = 'flex';
        modal.classList.add('fade-in');
    }
};

async function cargarTalleresEnSelect(tallerPreseleccionado) {
    const select = document.getElementById('cita-sucursal');
    if (!select) return;

    select.innerHTML = '<option value="" disabled selected>🔍 Buscando talleres...</option>';

    try {
        talleresDisponibles = await window.clienteTallerService.obtenerTalleresDisponibles();

        if (talleresDisponibles.length === 0) {
            select.innerHTML = '<option value="" disabled>No hay talleres disponibles</option>';
            return;
        }

        select.innerHTML = '<option value="" disabled selected>Selecciona un taller...</option>';

        talleresDisponibles.forEach(taller => {
            const option = document.createElement('option');
            option.value = taller._id;
            option.textContent = `${taller.nombre} - ${taller.direccion?.ciudad || ''} (${taller.bahiasDisponibles || 0} bahías)`;
            select.appendChild(option);
        });

        if (tallerPreseleccionado) {
            select.value = tallerPreseleccionado;
            window.alSeleccionarTaller(tallerPreseleccionado);
        }
    } catch (error) {
        select.innerHTML = '<option value="" disabled>Error al cargar talleres</option>';
    }
}

window.actualizarSelectVehiculos = function () {
    const select = document.getElementById('cita-vehiculo');
    if (!select) return;

    select.innerHTML = '<option value="" disabled selected>-- Selecciona un vehículo --</option>';

    const garaje = window.user.garaje;
    if (garaje.length > 0) {
        garaje.forEach(auto => {
            const option = document.createElement('option');
            const datos = {
                marca: auto.marca || 'Genérico',
                modelo: auto.modelo || 'Modelo',
                placa: auto.placa || 'S/P',
                color: auto.color || ''
            };
            option.value = JSON.stringify(datos);
            option.textContent = `${datos.marca} ${datos.modelo} (${datos.placa})`;
            option.dataset.marca = datos.marca;
            option.dataset.modelo = datos.modelo;
            option.dataset.placa = datos.placa;
            option.dataset.color = datos.color;
            select.appendChild(option);
        });
    }
};

window.cerrarModalCita = function () {
    const modal = document.getElementById('modal-cita');
    if (modal) modal.style.display = 'none';
};

// ==================== PROCESAMIENTO DE CITAS (USANDO CLASE CLIENTE) ====================

window.confirmarCita = async function (event) {
    if (event) event.preventDefault();

    if (window.citaEnviada) {
        window.mostrarToast('⏳ Ya se está procesando...', 'warning');
        return;
    }
    window.citaEnviada = true;

    const btn = document.getElementById('btn-agendar-cita');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Agendando...'; }

    try {
        const selectedOption = document.getElementById('cita-vehiculo')?.selectedOptions?.[0];
        const servicioSelect = document.getElementById('cita-servicio');
        const servicioNombre = servicioSelect?.value;
        const servicioPrecio = parseFloat(servicioSelect?.selectedOptions[0]?.dataset?.precio || 0);
        const tallerId = document.getElementById('cita-sucursal')?.value;
        const fecha = document.getElementById('cita-fecha')?.value;
        const hora = document.getElementById('cita-hora')?.value;
        const tallerElegido = talleresDisponibles.find(t => t._id === tallerId);

        if (!selectedOption || !servicioNombre || !tallerId || !fecha || !hora) {
            window.mostrarToast("⚠️ Completa todos los campos.", "warning");
            return;
        }

        const saldoActual = window.user.saldo;
        if (saldoActual < servicioPrecio) {
            window.mostrarToast(`⚠️ Saldo insuficiente. Necesitas RD$ ${servicioPrecio.toFixed(2)}`, "warning");
            return;
        }

        let vehiculoObj = {
            marca: selectedOption.dataset.marca || 'Genérico',
            modelo: selectedOption.dataset.modelo || 'Modelo',
            placa: selectedOption.dataset.placa || 'S/P',
            color: selectedOption.dataset.color || ''
        };

        // ✅ SOLO UNA llamada - crea en CitaTaller
        const response = await apiFetch(`/citas`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                usuarioId: window.obtenerIdUsuario(),
                datosCita: {
                    tallerId: tallerId,
                    vehiculo: vehiculoObj,
                    fecha,
                    hora,
                    sucursal: tallerElegido?.nombre || 'Taller',
                    servicio: servicioNombre,
                    metodoPago: 'SALDO',
                    montoPagado: servicioPrecio
                }
            })
        });

        const data = await response.json();

        if (data.exito) {
            // Descontar saldo
            window.user.saldo = saldoActual - servicioPrecio;
            window.persistirUsuario();

            window.mostrarToast('✅ Cita agendada exitosamente', 'success');
            window.cerrarModales();

            // Sincronizar para ver la cita nueva
            await window.sincronizarEstadoCitas();
        } else {
            throw new Error(data.mensaje || 'Error');
        }

    } catch (error) {
        logger.error('Error:', error);
        window.mostrarToast("❌ " + error.message, 'error');
    } finally {
        window.citaEnviada = false;
        if (btn) { btn.disabled = false; btn.textContent = 'AGENDAR CITA'; }
    }
};

// ==================== ESTADOS Y RENDERIZADO DE CITAS ====================

window.renderizarCitas = function () {
    const contenedorHistorial = document.getElementById('contenedor-citas-historial');
    const contenedorPendientes = document.getElementById('contenedor-citas-pendientes');

    if (!window.user) return;

    // Usar los getters de la clase Cliente
    const pendientes = window.user.citasPendientes;
    const historial = window.user.citasHistorial;

    if (contenedorPendientes) {
        contenedorPendientes.style.display = 'grid';
        contenedorPendientes.innerHTML = '';

        if (pendientes.length === 0) {
            contenedorPendientes.innerHTML = '<p style="color:#666;text-align:center;padding:20px;">🎉 No tienes citas pendientes.</p>';
        } else {
            [...pendientes].reverse().forEach(cita => {
                contenedorPendientes.appendChild(window.crearCardCita(cita, true));
            });
        }
    }


};

window.renderizarCitasPendientes = function () {
    const contenedor = document.getElementById('contenedor-citas-pendientes');
    if (!contenedor || !window.user) return;

    contenedor.innerHTML = '';
    const pendientes = window.user.citasPendientes;

    if (pendientes.length === 0) {
        contenedor.innerHTML = '<p style="color:#666;text-align:center;padding:20px;">🎉 No tienes citas pendientes.</p>';
        return;
    }

    [...pendientes].reverse().forEach(c => {
        contenedor.appendChild(window.crearCardCita(c, true));
    });
};

window.renderizarCitasHistorial = function () {
    const contenedor = document.getElementById('contenedor-citas-historial');

    if (!contenedor || !window.user) return;

    contenedor.innerHTML = '';
    const historial = window.user.citasHistorial;
    console.log("historia", historial)
    if (historial.length === 0) {
        contenedor.innerHTML = '<p style="color:#666;text-align:center;padding:20px;">📭 No hay historial todavía.</p>';
        return;
    }

    [...historial].reverse().forEach(c => {
        contenedor.appendChild(window.crearCardCita(c, false));
    });
};

// ==================== CREAR CARD DE CITA ====================

window.crearCardCita = function (cita, esPendiente) {
    const idFinal = cita._id || cita.id || cita.idCita;
    const estado = (cita.estado || ESTADOS_CITA.PENDIENTE).toUpperCase();
    const color = COLORES_ESTADO[estado] || '#00ff88';
    const icono = ICONO_ESTADO[estado] || '📌';
    const mensaje = MENSAJE_ESTADO[estado] || '';
    const progreso = PROGRESO_ESTADO[estado] || 10;

    const { modeloTxt, placaTxt } = obtenerDatosVehiculo(cita);
    const tallerNombre = cita.tallerNombre || cita.tallerId.nombre || 'Taller';

    const card = document.createElement('div');
    card.className = 'cita-card-cliente';
    card.style.cssText = `
        background: #111820;
        border: 1px solid #1a2530;
        border-left: 4px solid ${color};
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 14px;
        transition: all 0.3s ease;
    `;

    card.addEventListener('mouseenter', () => {
        card.style.borderColor = color + '44';
        card.style.boxShadow = `0 8px 25px ${color}10`;
        card.style.transform = 'translateY(-2px)';
    });
    card.addEventListener('mouseleave', () => {
        card.style.borderColor = '#1a2530';
        card.style.boxShadow = 'none';
        card.style.transform = 'translateY(0)';
    });

    card.innerHTML = `
        ${crearHeaderCitaHTML(icono, modeloTxt, placaTxt, estado, color)}
        ${crearInfoCitaHTML(cita, tallerNombre)}
        ${crearInfoBahiaHTML(cita)}
        ${crearBarraProgresoHTML(mensaje, color, progreso)}
        ${crearAccionesCitaHTML(idFinal, estado, esPendiente, cita)}
    `;

    return card;
};

function obtenerDatosVehiculo(cita) {
    let modeloTxt = "Vehículo";
    let placaTxt = "S/P";

    if (cita.vehiculo && typeof cita.vehiculo === 'object') {
        const marca = cita.vehiculo.marca || '';
        modeloTxt = `${marca} ${cita.vehiculo.modelo || ''}`.trim();
        placaTxt = cita.vehiculo.placa || "S/P";
    } else if (typeof cita.vehiculo === 'string') {
        const partes = cita.vehiculo.split('|');
        modeloTxt = partes[0] || "Vehículo";
        placaTxt = partes[1] || "S/P";
    }

    return { modeloTxt, placaTxt };
}

function crearHeaderCitaHTML(icono, modeloTxt, placaTxt, estado, color) {
    return `
        <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:14px;">
            <div style="display:flex; align-items:center; gap:12px;">
                <div style="
                    width:50px; height:50px; min-width:50px;
                    background:${color}15;
                    border:2px solid ${color}33;
                    border-radius:14px;
                    display:flex; align-items:center; justify-content:center;
                    font-size:1.6rem;
                ">${icono}</div>
                <div>
                    <h4 style="color:#fff; margin:0; font-size:1rem; font-weight:600;">${modeloTxt}</h4>
                    <span class="car-plate" style="margin-top:3px;">${placaTxt}</span>
                </div>
            </div>
            <span style="
                background:${color}18;
                color:${color};
                padding:5px 12px;
                border-radius:20px;
                font-size:0.7rem;
                font-weight:700;
                letter-spacing:1px;
                white-space:nowrap;
            ">${estado}</span>
        </div>`;
}

function crearInfoCitaHTML(cita, tallerNombre) {
    console.log("este es el nombre del taller ", tallerNombre);
    return `
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
            <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                <span>📅</span><span>${cita.fecha || 'S/F'}</span>
            </div>
            <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                <span>🕐</span><span>${cita.hora || '--:--'}</span>
            </div>
            <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                <span>🏪</span><span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${tallerNombre}</span>
            </div>
            <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                <span>🔧</span><span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${cita.servicio.nombre || 'Servicio'}</span>
            </div>
        </div>`;
}

function crearInfoBahiaHTML(cita) {
    console.log("fomacion empleado ")
    if (!cita.bahiaAsignada && !cita.empleadoAsignado) return '';
    return `
        <div style="display:flex; gap:15px; margin-bottom:12px; flex-wrap:wrap;">
            ${cita.bahiaAsignada ? `
            <div style="display:flex; align-items:center; gap:5px; background:rgba(255,187,51,0.08); padding:5px 10px; border-radius:8px; font-size:0.7rem; color:#ffbb33;">
                🏗️ Bahía #${cita.bahiaAsignada}
            </div>` : ''}
            ${cita.empleadoAsignado ? `
            <div style="display:flex; align-items:center; gap:5px; background:rgba(0,212,255,0.08); padding:5px 10px; border-radius:8px; font-size:0.7rem; color:#00d4ff;">
                👨‍🔧 ${typeof cita.empleadoAsignado === 'object' ? cita.empleadoAsignado.nombre : cita.empleadoAsignado}
            </div>` : ''}
        </div>`;
}

function crearBarraProgresoHTML(mensaje, color, progreso) {
    return `
        <div style="margin-bottom:14px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                <span style="font-size:0.65rem; color:#666;">Progreso</span>
                <span style="font-size:0.65rem; color:${color};">${mensaje}</span>
            </div>
            <div style="background:#1a1a1a; border-radius:8px; height:6px; overflow:hidden;">
                <div style="background:${color}; height:100%; width:${progreso}%; border-radius:8px; transition:width 0.5s ease;"></div>
            </div>
        </div>`;
}

function crearAccionesCitaHTML(idFinal, estado, esPendiente, cita) {
    let botonesHTML = '';

    // ✅ Cancelar (solo en PENDIENTE o CONFIRMADA)
    if (esPendiente && [ESTADOS_CITA.PENDIENTE, ESTADOS_CITA.CONFIRMADA].includes(estado)) {
        botonesHTML += `<button onclick="window.cancelarCita('${idFinal}')" class="btn-cita-cancelar">❌ Cancelar</button>`;
    }

    // ✅ Confirmar Entrega (solo en LISTO)
    if (estado === ESTADOS_CITA.LISTO) {
        botonesHTML += `<button onclick="window.abrirModalConfirmarEntrega('${idFinal}')" class="btn-cita-confirmar">🎉 Confirmar Entrega</button>`;
    }

    // ✅ Calificar (ENTREGADO y NO tiene calificación aún)
    if (estado === ESTADOS_CITA.ENTREGADO && !cita.calificacion?.puntuacion) {
        botonesHTML += `<button onclick="window.calificarServicio('${idFinal}')" class="btn-cita-calificar">⭐ Calificar</button>`;
    }

    // ✅ Mostrar estrellas si YA calificó
    if (cita.calificacion?.puntuacion && cita.calificacion.puntuacion > 0) {
        botonesHTML += `<span style="font-size:0.85rem; color:#ffbb33; padding:8px;">${'⭐'.repeat(cita.calificacion.puntuacion)}</span>`;
    }

    // ✅ Detalle
    if (cita.tallerId) {
        botonesHTML += `<button onclick="window.verDetalleCita('${idFinal}')" class="btn-cita-detalle">🔍 Detalle</button>`;
    }

    return `<div style="display:flex; gap:8px; flex-wrap:wrap;">${botonesHTML}</div>`;
}

// ==================== CANCELAR CITA ====================

// ==================== CANCELAR CITA (CORREGIDO PARA CITAS LOCALES) ====================

// ==================== CANCELAR CITA (VERSIÓN FINAL CORREGIDA) ====================

// ==================== CANCELAR CITA (VERSIÓN FINAL - FUNCIONANDO) ====================

window.cancelarCita = async function (idRecibido) {
    const cita = window.user.obtenerCita(idRecibido);
    if (!cita) {
        window.mostrarToast("❌ Cita no encontrada.", "error");
        return;
    }

    const nombre = typeof cita.vehiculo === 'object' ?
        `${cita.vehiculo.marca || ''} ${cita.vehiculo.modelo || ''}` : cita.vehiculo;
    const montoReembolso = cita.pago?.monto || 0;

    if (!confirm(`¿Cancelar cita de ${nombre}?\n\nSe reembolsará RD$ ${montoReembolso.toFixed(2)}`)) return;

    try {
        // ✅ Cancelar en CitaTaller
        const citaId = cita._id || cita.id;
        await apiFetch(`/citas/${citaId}/cancelar`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                usuarioId: window.obtenerIdUsuario(),
                motivo: 'Cancelado por el cliente'
            })
        });

        // Eliminar localmente
        window.user.eliminarCita(idRecibido);

        // Reembolsar
        if (montoReembolso > 0) {
            window.user.saldo += montoReembolso;
        }

        window.persistirUsuario();
        window.renderizarCitas();
        window.mostrarToast(`✅ Cita cancelada. RD$ ${montoReembolso.toFixed(2)} reembolsado.`, 'success');

    } catch (error) {
        window.mostrarToast("❌ Error al cancelar", "error");
    }
};

// ==================== SINCRONIZACIÓN DE ESTADO ====================

// ==================== SINCRONIZACIÓN DE ESTADO (RESPETA CANCELACIONES Y CITAS ELIMINADAS) ====================

// ==================== SINCRONIZACIÓN (FILTRA CANCELADAS) ====================


window.sincronizarEstadoCitas = async function () {
    const userId = window.obtenerIdUsuario();
    if (!userId) return;

    try {
        const response = await window.fetchConReintento(`/mis-citas/${userId}`);

        if (response.exito) {
            const citas = response.citas || [];
            const activas = citas.filter(c => !['CANCELADA', 'ENTREGADO'].includes(c.estado));
            const historial = citas.filter(c => ['ENTREGADO'].includes(c.estado));

            window.user.misCitas = [...activas, ...historial];
            window.persistirUsuario();

            // ✅ Solo renderizar la pestaña activa (no las dos)
            if (window.tabClienteActual === 'historial') {
                window.renderizarCitasHistorial();
            } else {
                window.renderizarCitasPendientes();
            }
        }
    } catch (error) {
        logger.error('❌ Error:', error.message);
    }
};

window.crearNotificacionEstado = function (citaTaller) {
    const vehiculoNombre = `${citaTaller.vehiculo?.marca || ''} ${citaTaller.vehiculo?.modelo || ''}`.trim();
    let mensaje = '';
    let tipo = '';

    switch (citaTaller.estado) {
        case ESTADOS_CITA.CONFIRMADA:
            mensaje = `✅ Cita para ${vehiculoNombre} CONFIRMADA`;
            tipo = 'CITA_CONFIRMADA';
            break;
        case ESTADOS_CITA.EN_RECEPCION:
            mensaje = `📥 ${vehiculoNombre} recibido en taller`;
            tipo = 'VEHICULO_RECIBIDO';
            break;
        case ESTADOS_CITA.EN_PROCESO:
            mensaje = `🔧 Trabajando en ${vehiculoNombre}`;
            tipo = 'TRABAJO_INICIADO';
            break;
        case ESTADOS_CITA.LISTO:
            mensaje = `🎉 ${vehiculoNombre} LISTO para recoger`;
            tipo = 'VEHICULO_LISTO';
            break;
        case ESTADOS_CITA.ENTREGADO:
            mensaje = `🏁 Servicio completado`;
            tipo = 'VEHICULO_ENTREGADO';
            break;
        case ESTADOS_CITA.CANCELADA:
            mensaje = `❌ Cita cancelada`;
            tipo = 'CITA_CANCELADA';
            break;
        default:
            mensaje = `📌 Cita actualizada: ${citaTaller.estado}`;
            tipo = 'ESTADO_ACTUALIZADO';
    }

    if (mensaje) {
        const notificaciones = JSON.parse(localStorage.getItem('notificaciones_clientes') || '[]');
        const yaExiste = notificaciones.some(n => n.tipo === tipo && n.mensaje === mensaje);
        if (!yaExiste) {
            notificaciones.push({
                tipo,
                citaId: citaTaller._id,
                mensaje,
                fecha: new Date().toISOString(),
                leida: false
            });
            localStorage.setItem('notificaciones_clientes', JSON.stringify(notificaciones));

            if (tipo === 'VEHICULO_LISTO') {
                window.mostrarToast(mensaje, 'success', 6000);
            } else if (tipo === 'CITA_CONFIRMADA') {
                window.mostrarToast(mensaje, 'info', 4000);
            }
        }
    }
};

