// ==================== DETALLE DE CITA ====================

window.verDetalleCita = function (citaId) {
    const cita = window.user.obtenerCita(citaId);
    if (!cita) return;

    const vehiculo = typeof cita.vehiculo === 'object'
        ? `${cita.vehiculo.marca || ''} ${cita.vehiculo.modelo || ''} (${cita.vehiculo.placa || ''})`
        : cita.vehiculo;
    console.log("esta es mi cita infomaxcio", cita.tallerId)
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); display:flex; align-items:center; justify-content:center; z-index:10000;';
    modal.innerHTML = `
        <div style="background:#111820; border:1px solid #1a2530; border-radius:16px; padding:25px; max-width:450px; width:90%;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 style="color:#fff; margin:0;">🔍 Detalle de Cita</h3>
                <span onclick="this.closest('div').parentElement.remove()" style="font-size:1.5rem; cursor:pointer; color:#888;">&times;</span>
            </div>
            <div style="display:flex; flex-direction:column; gap:10px; color:#ccc; font-size:0.9rem;">
                <p><strong>🚗 Vehículo:</strong> ${vehiculo}</p>
                <p><strong>📅 Fecha:</strong> ${cita.fecha || 'S/F'}</p>
                <p><strong>🕐 Hora:</strong> ${cita.hora || '--:--'}</p>
                <p><strong>🏪 Taller:</strong> ${cita.tallerId.nombre || 'No asignado'}</p>
                <p><strong>🔧 Servicio:</strong> ${cita.servicio.nombre || 'No especificado'}</p>
                <p><strong>📌 Estado:</strong> ${cita.estado || 'Pendiente'}</p>
                ${cita.bahiaAsignada ? `<p><strong>🏗️ Bahía:</strong> #${cita.bahiaAsignada}</p>` : ''}
                ${cita.montoPagado ? `<p><strong>💰 Monto:</strong> RD$ ${cita.montoPagado.toLocaleString()}</p>` : ''}
            </div>
            <button onclick="this.closest('div').parentElement.remove()" 
                style="width:100%; margin-top:20px; padding:12px; background:#00ff88; color:#000; border:none; border-radius:8px; cursor:pointer; font-weight:600;">
                CERRAR
            </button>
        </div>
    `;
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
    document.body.appendChild(modal);
};

// ==================== AGENDAR CITA CON VEHÍCULO ====================

window.agendarCitaConVehiculo = function (id) {
    const garaje = window.user.garaje;
    const vehiculo = garaje.find(v => (v.id || v._id) == id);
    if (!vehiculo) {
        window.mostrarToast('⚠️ Vehículo no encontrado', 'warning');
        return;
    }

    if (typeof window.abrirModalSolicitud === 'function') {
        window.abrirModalSolicitud();

        setTimeout(() => {
            const selectVehiculo = document.getElementById('cita-vehiculo');
            if (selectVehiculo) {
                for (let i = 0; i < selectVehiculo.options.length; i++) {
                    const option = selectVehiculo.options[i];
                    if (option.dataset.placa === vehiculo.placa ||
                        option.textContent.includes(vehiculo.placa)) {
                        selectVehiculo.selectedIndex = i;
                        break;
                    }
                }
            }
        }, 500);
    }
};

// ==================== GALERÍA ====================

// ==================== GALERÍA (FOTOS REALES DEL SERVIDOR) ====================

window.renderizarGaleria = async function () {
    const contenedor = document.getElementById('contenedor-galeria');
    if (!contenedor) return;

    contenedor.innerHTML = '<p style="color:#888;text-align:center;padding:40px;">⏳ Cargando galería...</p>';

    try {
        const userId = window.obtenerIdUsuario();

        // 1. Obtener citas del cliente
        const response = await apiFetch(`/mis-citas/${userId}`);
        const data = await response.json();

        if (!data.exito || !data.citas) {
            contenedor.innerHTML = '<p style="color:#666;text-align:center;padding:40px;">📭 No hay trabajos en la galería.</p>';
            return;
        }

        // 2. Filtrar solo ENTREGADAS
        const entregadas = data.citas.filter(c => c.estado === 'ENTREGADO');

        // 3. Filtros
        const busquedaPlaca = (document.getElementById('busqueda-placa')?.value || '').toLowerCase().trim();
        const filtroModelo = document.getElementById('filtro-modelo')?.value || 'todos';

        if (entregadas.length === 0) {
            contenedor.innerHTML = '<p style="color:#666;text-align:center;padding:40px;">📭 No tienes trabajos completados.</p>';
            return;
        }

        // Llenar filtro de modelos
        const modelosUnicos = [...new Set(entregadas.map(c =>
            `${c.vehiculo?.marca || ''} ${c.vehiculo?.modelo || ''}`.trim()
        ).filter(Boolean))];

        const selectModelo = document.getElementById('filtro-modelo');
        if (selectModelo) {
            selectModelo.innerHTML = '<option value="todos">🚗 Todos los modelos</option>' +
                modelosUnicos.map(m => `<option value="${m}">${m}</option>`).join('');
        }

        // Filtrar
        let citasFiltradas = entregadas;
        if (busquedaPlaca) {
            citasFiltradas = citasFiltradas.filter(c =>
                (c.vehiculo?.placa || '').toLowerCase().includes(busquedaPlaca)
            );
        }
        if (filtroModelo && filtroModelo !== 'todos') {
            citasFiltradas = citasFiltradas.filter(c => {
                const modeloCompleto = `${c.vehiculo?.marca || ''} ${c.vehiculo?.modelo || ''}`.trim();
                return modeloCompleto === filtroModelo;
            });
        }

        if (citasFiltradas.length === 0) {
            contenedor.innerHTML = '<p style="color:#666;text-align:center;padding:40px;">🔍 No hay trabajos con esos filtros.</p>';
            return;
        }

        // Renderizar
        contenedor.innerHTML = '';

        for (const cita of citasFiltradas) {
            const card = await crearCardGaleria(cita);
            contenedor.appendChild(card);
        }

    } catch (error) {
        console.error('❌ Error galería:', error);
        contenedor.innerHTML = '<p style="color:#ff4444;text-align:center;padding:40px;">Error al cargar galería.</p>';
    }
};

async function crearCardGaleria(cita) {
    const card = document.createElement('div');
    card.className = 'gallery-card';
    card.style.cssText = `
        background: #131c2b;
        border: 1px solid #1e2a3a;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
    `;

    const vehiculo = cita.vehiculo || {};
    const modeloTxt = `${vehiculo.marca || ''} ${vehiculo.modelo || ''}`.trim() || 'Vehículo';
    const placaTxt = vehiculo.placa || 'S/P';
    const fecha = cita.fecha || 'S/F';
    const servicio = cita.servicio?.nombre || cita.servicio || 'Servicio';
    const calificacion = cita.calificacion?.puntuacion || 0;
    const estrellas = calificacion > 0 ? '⭐'.repeat(calificacion) : '';

    // Obtener fotos reales
    let fotosAntes = [];
    let fotosDespues = [];

    try {
        const fotosResponse = await apiFetch(`/talleres/citas/${cita._id}/fotos`);
        const fotosData = await fotosResponse.json();
        if (fotosData.exito) {
            fotosAntes = fotosData.fotos?.antes || [];
            fotosDespues = fotosData.fotos?.despues || [];
        }
    } catch (e) {
        // Sin fotos
    }

    const tieneFotos = fotosAntes.length > 0 || fotosDespues.length > 0;

    card.innerHTML = `
        <div style="display:grid; grid-template-columns: ${tieneFotos ? '1fr 1fr' : '1fr'}; gap:8px; padding:15px;">
            <div style="text-align:center;">
                <div style="font-size:0.75rem; color:#ff6b6b; margin-bottom:8px;">🔴 ANTES</div>
                <div style="background:#0a0e14; border-radius:12px; height:180px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    ${fotosAntes.length > 0 ?
            `<img src="${fotosAntes[0].url}" style="width:100%; height:100%; object-fit:cover; cursor:pointer;" 
                             onclick="window.verFotoCompleta('${fotosAntes[0].url}', 'ANTES - ${modeloTxt}')">` :
            '<span style="color:#444; font-size:3rem;">📷</span>'}
                </div>
                ${fotosAntes.length > 1 ? `<small style="color:#888;">+${fotosAntes.length - 1} fotos más</small>` : ''}
            </div>
            ${tieneFotos ? `
            <div style="text-align:center;">
                <div style="font-size:0.75rem; color:#6bff6b; margin-bottom:8px;">🟢 DESPUÉS</div>
                <div style="background:#0a0e14; border-radius:12px; height:180px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    ${fotosDespues.length > 0 ?
                `<img src="${fotosDespues[0].url}" style="width:100%; height:100%; object-fit:cover; cursor:pointer;" 
                             onclick="window.verFotoCompleta('${fotosDespues[0].url}', 'DESPUÉS - ${modeloTxt}')">` :
                '<span style="color:#444; font-size:3rem;">📷</span>'}
                </div>
                ${fotosDespues.length > 1 ? `<small style="color:#888;">+${fotosDespues.length - 1} fotos más</small>` : ''}
            </div>` : ''}
        </div>
        <div style="padding:15px; border-top:1px solid #1e2a3a;">
            <div style="display:flex; justify-content:space-between; align-items:start;">
                <div>
                    <h4 style="color:#fff; margin:0 0 5px;">🚗 ${modeloTxt}</h4>
                    <span style="color:#888; font-size:0.8rem;">🏷️ ${placaTxt}</span>
                </div>
                <div style="text-align:right;">
                    <span style="color:#00ff88; font-size:0.8rem;">📅 ${fecha}</span>
                    <br><span style="color:#ffbb33; font-size:0.75rem;">🔧 ${servicio}</span>
                    ${estrellas ? `<br><span style="font-size:0.85rem;">${estrellas}</span>` : ''}
                </div>
            </div>
        </div>
    `;
    return card;
}

window.verFotoCompleta = function (url, titulo) {
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); display:flex; align-items:center; justify-content:center; z-index:10000; cursor:zoom-out;';
    modal.innerHTML = `
        <div style="text-align:center; max-width:90vw; max-height:90vh;">
            <p style="color:#fff; margin-bottom:15px; font-size:1.1rem;">${titulo}</p>
            <img src="${url}" style="max-width:90vw; max-height:75vh; border-radius:12px; box-shadow:0 10px 40px rgba(0,0,0,0.5);">
            <p style="color:#888; margin-top:15px;">Click para cerrar</p>
        </div>
    `;
    modal.addEventListener('click', () => modal.remove());
    document.body.appendChild(modal);
};

window.limpiarFiltros = function () {
    document.getElementById('busqueda-placa').value = '';
    document.getElementById('filtro-modelo').value = 'todos';
    window.renderizarGaleria();
};

window.verImagenFull = function (src) {
    if (!src) return;
    window.verFotoCompleta(src, 'Foto');
};


// ==================== PERFIL ====================

window.renderizarPerfil = function () {
    const user = window.user;
    if (!user) return;

    document.getElementById('perf-nombre').value = user.nombre || '';
    document.getElementById('perf-apellido').value = user.apellido || '';
    document.getElementById('perf-whatsapp').value = user.whatsapp || '';
    document.getElementById('perf-email').value = user.email || '';
    document.getElementById('preview-foto-perfil').src = user.fotoPerfil || './assets/default-avatar.png';
    document.getElementById('perfil-nombre-display').textContent = user.nombre || 'Usuario';
    document.getElementById('perfil-email-display').textContent = user.email || '';
    document.getElementById('perfil-plan-badge').textContent = 'Plan: ' + (user.planActual || 'Ninguno');

    const historial = user.citasHistorial;
    document.getElementById('perfil-total-citas').textContent = historial.length;
    document.getElementById('perfil-total-gastado').textContent = 'RD$ ' + historial
        .reduce((s, c) => s + (c.montoPagado || 0), 0).toLocaleString();
    document.getElementById('perfil-vehiculos-count').textContent = user.garaje.length;

    window.renderizarHistorialFinanciero();
};

window.renderizarHistorialFinanciero = function () {
    const contenedor = document.getElementById('lista-transacciones');
    if (!contenedor) return;

    let transacciones = [];

    const misCitas = window.user.misCitas;
    misCitas.forEach(c => {
        if (c.montoPagado > 0) {
            transacciones.push({
                fecha: c.fecha || c.fechaRegistro,
                concepto: 'Cita: ' + (c.servicio || 'Servicio'),
                monto: c.montoPagado,
                tipo: 'PAGO'
            });
        }
    });

    transacciones.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

    if (transacciones.length === 0) {
        contenedor.innerHTML = '<p style="color:#666;text-align:center;">No hay transacciones.</p>';
        return;
    }

    contenedor.innerHTML = transacciones.map(t => `
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #1e2a3a;">
            <div>
                <p style="color:#fff;font-size:0.85rem;margin:0;">${t.concepto}</p>
                <small style="color:#888;">${new Date(t.fecha).toLocaleDateString('es-DO')}</small>
            </div>
            <span style="color:${t.tipo === 'RECARGA' || t.tipo === 'REEMBOLSO' ? '#00ff88' : '#ff4444'};font-weight:600;">
                ${t.tipo === 'RECARGA' || t.tipo === 'REEMBOLSO' ? '+' : '-'} RD$ ${t.monto.toLocaleString()}
            </span>
        </div>`).join('');
};

window.guardarCambiosPerfil = async function (e) {
    if (e) e.preventDefault();
    const btn = document.getElementById('btn-guardar-perfil');
    const orig = btn.innerHTML;

    const telefono = document.getElementById('perf-whatsapp').value;

    if (telefono && !validadores.telefono(telefono)) {
        window.mostrarToast('⚠️ Formato de teléfono inválido. Use: 8095551234', 'warning');
        return;
    }

    window.user.nombre = document.getElementById('perf-nombre').value;
    window.user.apellido = document.getElementById('perf-apellido').value;
    window.user.whatsapp = telefono;

    btn.innerHTML = "Guardando... ✨";
    btn.disabled = true;
    window.estadoCarga.mostrar('Guardando perfil...');

    try {
        const exito = await window.db.sincronizarConServidor();
        if (exito) {
            window.persistirUsuario();
            window.mostrarToast("✅ Perfil actualizado exitosamente.", "success");
            window.actualizarInterfaz(window.user);
        } else {
            window.mostrarToast("⚠️ No se pudo sincronizar con el servidor.", "warning");
        }
    }
    catch (error) {
        logger.error('Error al guardar perfil:', error);
        window.mostrarToast("❌ Error al guardar los cambios.", "error");
    }
    finally {
        btn.innerHTML = orig;
        btn.disabled = false;
        window.estadoCarga.ocultar();
    }
};

window.actualizarPassword = async function (e) {
    if (e) e.preventDefault();
    const actual = document.getElementById('pass-actual').value;
    const nueva = document.getElementById('pass-nueva').value;
    const confirma = document.getElementById('pass-confirma').value;

    if (nueva !== confirma) {
        window.mostrarToast("❌ Las contraseñas no coinciden.", "error");
        return;
    }
    if (nueva.length < 8) {
        window.mostrarToast("⚠️ La contraseña debe tener mínimo 8 caracteres.", "warning");
        return;
    }

    const btn = e.target.querySelector('button');
    btn.innerHTML = "Actualizando... 🔐";
    btn.disabled = true;
    window.estadoCarga.mostrar('Actualizando contraseña...');

    try {
        const d = await window.fetchConReintento(`/usuarios/update-password`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email: window.user.email,
                passwordActual: actual,
                passwordNueva: nueva
            })
        });
        if (d.exito) {
            window.mostrarToast("✅ Contraseña actualizada exitosamente.", "success");
            document.getElementById('form-password').reset();
        } else {
            window.mostrarToast("❌ " + d.mensaje, "error");
        }
    } catch (error) {
        logger.error('Error al actualizar contraseña:', error);
        window.mostrarToast("🔌 Error de conexión.", "error");
    }
    finally {
        btn.innerHTML = "Actualizar Contraseña";
        btn.disabled = false;
        window.estadoCarga.ocultar();
    }
};

// ==================== FOTO DE PERFIL ====================

window.procesarImagenParaPerfil = async function (inputElement) {
    const file = inputElement.files[0];
    if (!file) return;

    const tiposPermitidos = ['image/jpeg', 'image/png', 'image/webp'];
    if (!tiposPermitidos.includes(file.type)) {
        window.mostrarToast("⚠️ Formato no permitido. Usa JPG, PNG o WebP.", "warning");
        return;
    }

    if (file.size > 1024 * 1024) {
        window.mostrarToast("⚠️ Imagen muy pesada. Máximo 1MB.", "warning");
        return;
    }

    window.estadoCarga.mostrar('Subiendo foto de perfil...');

    try {
        const formData = new FormData();

        // ✅ CORREGIDO 1: Enviar con el nombre 'foto' (como espera el backend)
        formData.append('foto', file);

        // ✅ CORREGIDO 2: Enviar el usuarioId que el backend necesita
        const usuarioId = window.user?._id || window.user?.id;
        if (!usuarioId) {
            window.mostrarToast("❌ Error: No se encontró el usuario", "error");
            window.estadoCarga.ocultar();
            return;
        }
        formData.append('usuarioId', usuarioId);

        console.log('📤 Subiendo foto de perfil:', {
            nombreArchivo: file.name,
            tamaño: file.size,
            usuarioId
        });

        const data = await window.fetchConReintento(`${API_BASE_URL}/upload/perfil`, {
            method: 'POST',
            body: formData
        });

        if (data.exito) {
            window.user.fotoPerfil = data.url;
            document.querySelectorAll('#preview-foto-perfil,#avatar-sidebar,#user-photo-header')
                .forEach(img => img.src = data.url);
            window.persistirUsuario();
            await window.db.sincronizarConServidor();
            window.mostrarToast("✅ Foto de perfil actualizada.", "success");

            console.log('✅ Foto subida correctamente:', data.url);
        } else {
            window.mostrarToast("❌ Error al subir la imagen.", "error");
        }
    } catch (error) {
        logger.error('Error al subir foto de perfil:', error);
        window.mostrarToast("❌ Error de conexión.", "error");
    } finally {
        window.estadoCarga.ocultar();
    }
};

// ==================== NAVEGACIÓN ====================

window.navegar = function (event) {
    if (event) event.preventDefault();

    let idFinal;
    if (event.target.closest('[data-href]')) {
        idFinal = event.target.closest('[data-href]').getAttribute('data-href').replace('#', '');
    } else if (event.target.closest('a')) {
        const href = event.target.closest('a').getAttribute('href');
        idFinal = href ? href.replace('#', '') : 'dashboard';
    } else {
        idFinal = 'dashboard';
    }

    if (!idFinal || idFinal === '#') return;

    document.querySelectorAll('.side-links a').forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + idFinal) link.classList.add('active');
    });

    window.mostrarSeccion(idFinal);
    window.limpiarCache();
};

window.mostrarSeccion = function (idDestino) {
    // Detener actualización en tiempo real si existe
    if (window.resenasSocial) {
        window.resenasSocial.detenerActualizacionTiempoReal();
    }

    document.querySelectorAll('.dash-section').forEach(s => s.style.display = 'none');

    const extraServices = document.querySelector('.extra-services');
    const statsGrid = document.querySelector('.stats-grid');
    const workshops = document.getElementById('talleres');
    const herade = document.getElementById('moda-inicio');

    if (extraServices) extraServices.style.display = 'none';
    if (statsGrid) statsGrid.style.display = 'none';
    if (workshops) workshops.style.display = 'none';

    const seccionMostrar = document.getElementById(idDestino);
    if (seccionMostrar) seccionMostrar.style.display = 'block';

    if (idDestino === 'dashboard') {
        if (statsGrid) statsGrid.style.display = 'grid';
        // if (extraServices) extraServices.style.display = 'block';
        // if (workshops) workshops.style.display = 'block';
    }
    if (idDestino === 'inicio') {
        console.log('gracia mundo');
        herade.style.display = 'grid';
    }
    if (idDestino === 'perfil') window.renderizarPerfil();
    if (idDestino === 'galeria') window.galeriaTrabajos?.cargar(); // ✅ NUEVO
    if (idDestino === 'explorar-talleres') window.cargarTalleresExplorar();

    window.scrollTo({ top: 0, behavior: 'smooth' });
};

// ==================== NOTIFICACIONES ====================

window.cargarNotificaciones = function () {
    const notificaciones = JSON.parse(localStorage.getItem('notificaciones_clientes') || '[]');
    const noLeidas = notificaciones.filter(n => !n.leida);
    const badge = document.getElementById('notif-badge');
    if (badge) {
        badge.style.display = noLeidas.length > 0 ? 'flex' : 'none';
        badge.textContent = noLeidas.length || '0';
    }
};

window.mostrarNotificaciones = function () {
    const modal = document.getElementById('modal-notificaciones');
    const lista = document.getElementById('lista-notificaciones');
    if (!modal || !lista) return;

    const notificaciones = JSON.parse(localStorage.getItem('notificaciones_clientes') || '[]');

    if (notificaciones.length === 0) {
        lista.innerHTML = '<p style="color:#666;text-align:center;padding:20px;">📭 Sin notificaciones</p>';
    } else {
        lista.innerHTML = notificaciones.reverse().map((notif, index) => {
            const icono = notif.tipo === 'CITA_CONFIRMADA' ? '✅' :
                notif.tipo === 'VEHICULO_LISTO' ? '🎉' : '📌';
            const bg = notif.leida ? 'transparent' : 'rgba(0,255,136,0.05)';
            const border = notif.leida ? '#333' : '#00ff88';
            return `
                <div style="background:${bg};border-left:3px solid ${border};padding:12px;margin-bottom:8px;border-radius:8px;cursor:pointer;" 
                     onclick="window.marcarLeida(${index})">
                    <div style="display:flex;align-items:start;gap:10px;">
                        <span style="font-size:1.2rem;">${icono}</span>
                        <div style="flex:1;">
                            <p style="margin:0;font-size:0.9rem;color:#fff;">${notif.mensaje}</p>
                            <small style="color:#888;">
                                ${new Date(notif.fecha).toLocaleString('es-DO')} 
                                ${notif.leida ? '✓' : '🔵'}
                            </small>
                        </div>
                    </div>
                </div>`;
        }).join('');
    }
    modal.style.display = 'flex';
    window.cargarNotificaciones();
};

window.marcarLeida = function (index) {
    const notificaciones = JSON.parse(localStorage.getItem('notificaciones_clientes') || '[]');
    const realIndex = notificaciones.length - 1 - index;
    if (notificaciones[realIndex]) {
        notificaciones[realIndex].leida = true;
        localStorage.setItem('notificaciones_clientes', JSON.stringify(notificaciones));
        window.mostrarNotificaciones();
    }
};

window.marcarTodasLeidas = function () {
    const notificaciones = JSON.parse(localStorage.getItem('notificaciones_clientes') || '[]');
    notificaciones.forEach(n => n.leida = true);
    localStorage.setItem('notificaciones_clientes', JSON.stringify(notificaciones));
    window.mostrarNotificaciones();
    window.cargarNotificaciones();
    window.mostrarToast('✅ Todas las notificaciones marcadas como leídas', 'success');
};

// ==================== PESTAÑAS DE CITAS ====================

window.cambiarTabCliente = function (tab) {
    window.tabClienteActual = tab;

    const contPendientes = document.getElementById('contenedor-citas-pendientes');
    const contHistorial = document.getElementById('contenedor-citas-historial');
    const btnP = document.getElementById('tab-pendientes-cliente');
    const btnH = document.getElementById('tab-historial-cliente');

    // Mostrar/ocultar
    if (contPendientes) contPendientes.style.display = tab === 'pendientes' ? 'grid' : 'none';
    if (contHistorial) contHistorial.style.display = tab === 'historial' ? 'grid' : 'none';

    // Estilos de botones
    const activo = { bg: 'rgba(0,255,136,0.1)', border: '#00ff88', color: '#00ff88' };
    const inactivo = { bg: 'transparent', border: '#333', color: '#aaa' };

    if (btnP) {
        btnP.style.background = tab === 'pendientes' ? activo.bg : inactivo.bg;
        btnP.style.borderColor = tab === 'pendientes' ? activo.border : inactivo.border;
        btnP.style.color = tab === 'pendientes' ? activo.color : inactivo.color;
    }
    if (btnH) {
        btnH.style.background = tab === 'historial' ? activo.bg : inactivo.bg;
        btnH.style.borderColor = tab === 'historial' ? activo.border : inactivo.border;
        btnH.style.color = tab === 'historial' ? activo.color : inactivo.color;
    }

    // ✅ Renderizar SOLO la pestaña activa
    if (tab === 'pendientes') {
        window.renderizarCitasPendientes();
    } else {
        window.renderizarCitasHistorial();
    }
};

// ==================== TALLER Y FECHA ====================

window.alSeleccionarTaller = async function (tallerId) {
    if (!tallerId) return;
    tallerSeleccionadoActual = talleresDisponibles.find(t => t._id === tallerId);

    const info = document.getElementById('taller-info');
    if (tallerSeleccionadoActual && info) {
        info.style.display = 'block';
        info.innerHTML = `📍 ${tallerSeleccionadoActual.direccion?.calle || ''}, ${tallerSeleccionadoActual.direccion?.ciudad || ''} | 📞 ${tallerSeleccionadoActual.telefono || 'N/D'} | 🔧 ${tallerSeleccionadoActual.bahiasDisponibles || 0} bahías | ⭐ ${tallerSeleccionadoActual.calificacion?.promedio || 'N/A'}/5`;
    }

    // ✅ CARGAR SERVICIOS DINÁMICOS DEL TALLER
    await cargarServiciosDelTaller(tallerId);

    if (document.getElementById('cita-fecha')?.value) window.alCambiarFecha();
};

/**
 * ✅ Cargar servicios del taller seleccionado
 */
async function cargarServiciosDelTaller(tallerId) {
    const selectServicio = document.getElementById('cita-servicio');
    if (!selectServicio) return;

    selectServicio.innerHTML = '<option value="" disabled>🔍 Cargando servicios...</option>';

    try {
        const response = await apiFetch(`/talleres/${tallerId}/servicios`);
        const data = await response.json();

        if (data.exito && data.servicios.length > 0) {
            selectServicio.innerHTML = '<option value="" disabled selected>Selecciona un servicio...</option>';

            data.servicios
                .filter(s => s.activo !== false)
                .forEach(servicio => {
                    const option = document.createElement('option');
                    option.value = servicio.nombre;
                    option.textContent = `${servicio.nombre} - RD$ ${servicio.precio?.toLocaleString()} (${servicio.duracionEstimada || 45} min)`;
                    option.dataset.precio = servicio.precio;
                    option.dataset.duracion = servicio.duracionEstimada || 45;
                    selectServicio.appendChild(option);
                });
        } else {
            // Si no hay servicios, usar los por defecto
            selectServicio.innerHTML = `
                <option value="" disabled selected>Selecciona un servicio</option>
                <option value="Lavado Básico" data-precio="500">Lavado Básico (RD$ 500)</option>
                <option value="Lavado Premium" data-precio="1200">Lavado Premium (RD$ 1,200)</option>
                <option value="Detallado Interior" data-precio="2500">Detallado Interior (RD$ 2,500)</option>
                <option value="Pulido Completo" data-precio="3500">Pulido Completo (RD$ 3,500)</option>
            `;
        }
    } catch (error) {
        console.error('Error al cargar servicios:', error);
        selectServicio.innerHTML = '<option value="" disabled>Error al cargar servicios</option>';
    }
}

window.alCambiarFecha = async function () {
    const fecha = document.getElementById('cita-fecha')?.value;
    const tallerId = document.getElementById('cita-sucursal')?.value;
    const selectHora = document.getElementById('cita-hora');
    const dispInfo = document.getElementById('disponibilidad-info');

    if (!fecha || !tallerId || !selectHora) return;

    const fechaObj = new Date(fecha + 'T12:00:00');
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);

    if (fechaObj < hoy) {
        dispInfo.textContent = '⚠️ No puedes agendar en el pasado';
        dispInfo.style.color = '#ff4444';
        selectHora.innerHTML = '<option disabled>Fecha no válida</option>';
        return;
    }

    const maxFecha = new Date();
    maxFecha.setDate(maxFecha.getDate() + 30);
    if (fechaObj > maxFecha) {
        dispInfo.textContent = '⚠️ Solo se agenda con 30 días de anticipación';
        dispInfo.style.color = '#ff4444';
        selectHora.innerHTML = '<option disabled>Fecha muy lejana</option>';
        return;
    }

    if (fechaObj.getDay() === 0) {
        dispInfo.textContent = '⚠️ Cerrado domingos';
        dispInfo.style.color = '#ff4444';
        selectHora.innerHTML = '<option disabled>No disponible</option>';
        return;
    }

    selectHora.innerHTML = '<option disabled>🔍 Verificando...</option>';

    try {
        const horarios = await window.clienteTallerService.obtenerHorariosDisponibles(tallerId, fecha);
        if (horarios.length === 0) {
            selectHora.innerHTML = '<option disabled>No disponible</option>';
            dispInfo.textContent = '⚠️ Sin disponibilidad';
            dispInfo.style.color = '#ff4444';
            return;
        }

        selectHora.innerHTML = '<option value="" disabled selected>Selecciona horario...</option>';
        horarios.forEach(h => {
            const opt = document.createElement('option');
            opt.value = h.hora;
            opt.textContent = h.hora + (h.disponible ? ' ✅' : ' ❌');
            opt.disabled = !h.disponible;
            selectHora.appendChild(opt);
        });

        const disponibles = horarios.filter(h => h.disponible).length;
        dispInfo.textContent = `✅ ${disponibles} horarios disponibles`;
        dispInfo.style.color = '#00ff88';
    } catch (error) {
        logger.error('Error al obtener horarios:', error);
        selectHora.innerHTML = '<option disabled>Error al cargar</option>';
    }
};

// ==================== UTILIDADES ====================

window.actualizarYRenderizar = function () {
    if (!window.user) return;
    db.sincronizarConServidor();
    window.actualizarInterfaz();
    window.renderizarCitas();
    if (typeof window.renderizarGaleria === 'function') window.renderizarGaleria();
};

window.crearTicket = function () {
    if (confirm('¿Hablar por WhatsApp?')) window.open('https://wa.me/tu_numero_aqui', '_blank');
};

window.cerrarSesion = function () {
    if (confirm('¿Estás seguro de cerrar sesión?')) {
        window.detenerSincronizacion();
        window.limpiarCache();
        localStorage.removeItem('sesion_activa');
        window.location.href = '../index.html';
    }
};

//taller

// ====================================================================
// 🔍 EXPLORAR TALLERES
// ====================================================================

let talleresExplorar = [];
let tallerSeleccionadoId = null;

/**
 * Cargar talleres para explorar
 */
window.cargarTalleresExplorar = async function () {
    const container = document.getElementById('lista-talleres');
    if (!container) return;

    container.innerHTML = '<p style="color:#888; grid-column:1/-1; text-align:center; padding:40px;">🔍 Buscando talleres disponibles...</p>';

    try {
        // ✅ Usar la variable global del módulo
        const url = `${API_BASE_URL}/talleres/disponibles`;
        console.log('🔍 Consultando:', url);

        const response = await apiFetch(url);
        const data = await response.json();

        console.log('📊 Talleres recibidos:', data);

        if (data.exito && data.talleres && data.talleres.length > 0) {
            talleresExplorar = data.talleres;
            llenarFiltrosExplorar(data.talleres);
            window.filtrarTalleres();
        } else {
            container.innerHTML = '<p style="color:#888; grid-column:1/-1; text-align:center; padding:40px;">📭 No hay talleres disponibles en este momento</p>';
        }
    } catch (error) {
        console.error('❌ Error al cargar talleres:', error);
        container.innerHTML = `<p style="color:#ff4444; grid-column:1/-1; text-align:center; padding:40px;">Error: ${error.message}</p>`;
    }
};
/**
 * Llenar filtros de búsqueda
 */
function llenarFiltrosExplorar(talleres) {
    // Ciudades únicas
    const ciudades = [...new Set(talleres.map(t => t.direccion?.ciudad).filter(Boolean))];
    const selectCiudad = document.getElementById('filtro-ciudad');
    if (selectCiudad) {
        selectCiudad.innerHTML = '<option value="">Todas las ciudades</option>' +
            ciudades.map(c => `<option value="${c}">${c}</option>`).join('');
    }

    // Especialidades únicas
    const especialidades = [...new Set(talleres.map(t => t.especialidad).filter(Boolean))];
    const selectEspecialidad = document.getElementById('filtro-especialidad');
    if (selectEspecialidad) {
        selectEspecialidad.innerHTML = '<option value="">Todas las especialidades</option>' +
            especialidades.map(e => `<option value="${e}">${e}</option>`).join('');
    }
}

/**
 * Filtrar talleres
 */
window.filtrarTalleres = function () {
    const busqueda = (document.getElementById('busqueda-taller')?.value || '').toLowerCase();
    const ciudad = document.getElementById('filtro-ciudad')?.value || '';
    const especialidad = document.getElementById('filtro-especialidad')?.value || '';

    let filtrados = talleresExplorar;

    if (busqueda) {
        filtrados = filtrados.filter(t =>
            t.nombre?.toLowerCase().includes(busqueda) ||
            t.direccion?.ciudad?.toLowerCase().includes(busqueda) ||
            t.direccion?.calle?.toLowerCase().includes(busqueda)
        );
    }
    if (ciudad) filtrados = filtrados.filter(t => t.direccion?.ciudad === ciudad);
    if (especialidad) filtrados = filtrados.filter(t => t.especialidad === especialidad);

    renderizarTalleres(filtrados);
};

// Evento de búsqueda en tiempo real
document.addEventListener('DOMContentLoaded', () => {
    const inputBusqueda = document.getElementById('busqueda-taller');
    if (inputBusqueda) {
        inputBusqueda.addEventListener('input', () => window.filtrarTalleres());
    }
});

/**
 * Renderizar tarjetas de talleres
 */
function renderizarTalleres(talleres) {
    const container = document.getElementById('lista-talleres');
    if (!container) return;

    if (talleres.length === 0) {
        container.innerHTML = '<p style="color:#888; grid-column:1/-1; text-align:center; padding:40px;">📭 No se encontraron talleres</p>';
        return;
    }

    const tallerVinculadoId = window.tallerManager?.getTallerId();

    container.innerHTML = talleres.map(taller => {
        const estrellas = taller.calificacion?.promedio ? '⭐'.repeat(Math.round(taller.calificacion.promedio)) : 'Sin calificar';
        const bahiasLibres = taller.bahiasDisponibles || 0;
        const estaVinculado = tallerVinculadoId === taller._id;

        // ✅ Logo del taller o placeholder
        const logoHTML = taller.logo
            ? `<img src="${taller.logo}" style="width:100%; height:100%; object-fit:cover; border-radius:14px;" onerror="this.style.display='none'; this.parentElement.innerHTML='🏪';">`
            : '🏪';

        return `
        <div class="taller-card" onclick="window.seleccionarTallerExplorar('${taller._id}')" 
            style="background:#131c2b; border:2px solid ${estaVinculado ? '#ffbb33' : '#1e2a3a'}; border-radius:15px; padding:20px; cursor:pointer; transition:all 0.3s ease; ${estaVinculado ? 'box-shadow: 0 0 20px rgba(255,187,51,0.15);' : ''}"
            onmouseover="this.style.borderColor='#00ff88'; this.style.transform='translateY(-3px)';" 
            onmouseout="this.style.borderColor='${estaVinculado ? '#ffbb33' : '#1e2a3a'}'; this.style.transform='translateY(0)';">
            
            <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:15px;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <!-- ✅ Logo del taller -->
                    <div style="width:50px; height:50px; min-width:50px; background:${estaVinculado ? 'rgba(255,187,51,0.1)' : 'rgba(0,255,136,0.08)'}; border:2px solid ${estaVinculado ? 'rgba(255,187,51,0.3)' : 'rgba(0,255,136,0.2)'}; border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; overflow:hidden;">
                        ${logoHTML}
                    </div>
                    <div>
                        <div style="display:flex; align-items:center; gap:6px;">
                            <h4 style="color:#fff; margin:0; font-size:1rem;">${taller.nombre}</h4>
                            ${estaVinculado ? '<span style="background:#ffbb3322; color:#ffbb33; padding:2px 8px; border-radius:10px; font-size:0.6rem; font-weight:600;">⭐ MI TALLER</span>' : ''}
                        </div>
                        <span style="color:#ffbb33; font-size:0.8rem;">${estrellas}</span>
                    </div>
                </div>
                ${bahiasLibres > 0 ? `<span style="background:rgba(0,255,136,0.1); color:#00ff88; padding:5px 10px; border-radius:20px; font-size:0.7rem; font-weight:600; white-space:nowrap;">🟢 ${bahiasLibres} libre${bahiasLibres > 1 ? 's' : ''}</span>` : ''}
            </div>
            
            <!-- ✅ Descripción del taller -->
            ${taller.descripcion ? `
            <div style="margin-bottom:12px;">
                <p style="color:#aaa; font-size:0.8rem; line-height:1.4; margin:0;">📝 ${taller.descripcion.substring(0, 100)}${taller.descripcion.length > 100 ? '...' : ''}</p>
            </div>` : ''}
            
            <div style="display:flex; flex-direction:column; gap:6px; margin-bottom:15px;">
                <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                    <span>📍</span>
                    <span>${taller.direccion?.calle || ''}, ${taller.direccion?.ciudad || ''}</span>
                </div>
                <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                    <span>🔧</span>
                    <span>${taller.especialidad || 'General'} · ${taller.bahias?.length || 0} bahías</span>
                </div>
                <!-- ✅ Métodos de pago -->
                ${taller.metodosPago && taller.metodosPago.length > 0 ? `
                <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                    <span>💳</span>
                    <span>${taller.metodosPago.map(m => ({ 'EFECTIVO': '💵', 'TRANSFERENCIA': '🏦', 'TARJETA': '💳' })[m] || m).join(' ')}</span>
                </div>` : ''}
            </div>
            <!-- ✅ Tipos de vehículos -->
            ${taller.tiposVehiculos && taller.tiposVehiculos.length > 0 ? `
            <div style="display:flex; align-items:center; gap:6px; color:#8892a4; font-size:0.8rem;">
                <span>🚗</span>
                <span>${taller.tiposVehiculos.map(t => ({ 'AUTO': '🚗', 'CAMIONETA': '🚙', 'MOTO': '🏍️', 'CAMION': '🚛', 'BUS': '🚌', 'OTRO': '⚙️' })[t] || t).join(' ')}</span>
            </div>` : ''}
            <div style="display:flex; gap:8px;">
                <button onclick="event.stopPropagation(); window.seleccionarTallerExplorar('${taller._id}')" 
                    style="flex:1; padding:10px; background:#00ff88; color:#000; border:none; border-radius:8px; cursor:pointer; font-weight:600; font-size:0.8rem;">
                    👁️ Ver detalles
                </button>
                <button onclick="event.stopPropagation(); window.vincularTallerDesdeExplorar('${taller._id}')" 
                    style="flex:1; padding:10px; background:${estaVinculado ? '#ffbb33' : 'transparent'}; border:1px solid #ffbb33; color:${estaVinculado ? '#000' : '#ffbb33'}; border-radius:8px; cursor:pointer; font-size:0.8rem; font-weight:600;">
                    ${estaVinculado ? '✅ Vinculado' : '🏪 Vincular'}
                </button>
                <button onclick="event.stopPropagation(); window.agendarEnTaller('${taller._id}')" 
                    style="padding:10px 12px; background:transparent; border:1px solid #00ff88; color:#00ff88; border-radius:8px; cursor:pointer; font-size:0.8rem; white-space:nowrap;">
                    📅
                </button>
            </div>
        </div>`;
    }).join('');
}

/**
 * Seleccionar taller para ver detalles
 */
window.seleccionarTallerExplorar = async function (tallerId) {
    tallerSeleccionadoId = tallerId;

    // Actualizar estilos de las tarjetas
    window.filtrarTalleres();

    // Mostrar detalle
    const detalleContainer = document.getElementById('taller-detalle');
    if (!detalleContainer) return;

    detalleContainer.style.display = 'block';
    detalleContainer.innerHTML = '<p style="color:#888; text-align:center; padding:20px;">⏳ Cargando detalles...</p>';

    // Scroll al detalle
    detalleContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });

    try {
        // Cargar datos del taller
        const [tallerRes, serviciosRes, planesRes] = await Promise.all([
            apiFetch(`/talleres/${tallerId}`),
            apiFetch(`/talleres/${tallerId}/servicios`),
            apiFetch(`/talleres/${tallerId}/planes`)
        ]);

        const tallerData = await tallerRes.json();
        const serviciosData = await serviciosRes.json();
        const planesData = await planesRes.json();

        if (!tallerData.exito) {
            detalleContainer.innerHTML = '<p style="color:#ff4444;">Error al cargar taller</p>';
            return;
        }

        const t = tallerData.taller;
        const servicios = serviciosData.servicios?.filter(s => s.activo !== false) || [];
        const planes = planesData.planes?.filter(p => p.activo !== false) || [];
        const estrellas = t.calificacion?.promedio ? '⭐'.repeat(Math.round(t.calificacion.promedio)) : 'Sin calificar';
        const direccion = `${t.direccion?.calle || ''}, ${t.direccion?.ciudad || ''}, ${t.direccion?.provincia || ''}`;
        const estaVinculado = window.tallerManager?.getTallerId() === tallerId;

        // ✅ Iconos de métodos de pago
        const iconosPago = {
            'EFECTIVO': '💵',
            'TRANSFERENCIA': '🏦',
            'TARJETA': '💳',
            'OTRO': '📌'
        };
        const metodosPagoTexto = t.metodosPago?.map(m => iconosPago[m] || m).join(' ') || '';

        detalleContainer.innerHTML = `
            <!-- Encabezado -->
            <div style="display:flex; justify-content:space-between; align-items:start; flex-wrap:wrap; gap:15px; margin-bottom:20px;">
                <div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <!-- ✅ LOGO DEL TALLER (NUEVO) -->
                        ${t.logo
                ? `<img src="${t.logo}" style="width:50px; height:50px; border-radius:50%; object-fit:cover; border:2px solid #00ff88;" onerror="this.style.display='none';">`
                : '<span style="font-size:2rem;">🏪</span>'}
                        <div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <h3 style="color:#fff; margin:0; font-size:1.3rem;">${t.nombre}</h3>
                                ${estaVinculado ? '<span style="background:#ffbb3322; color:#ffbb33; padding:3px 10px; border-radius:15px; font-size:0.7rem; font-weight:600;">⭐ MI TALLER</span>' : ''}
                            </div>
                            <p style="color:#ffbb33; margin:5px 0;">${estrellas} ${t.calificacion?.promedio?.toFixed(1) || 'N/A'} (${t.calificacion?.totalReseñas || 0} reseñas)</p>
                        </div>
                    </div>
                    <!-- ✅ DESCRIPCIÓN DEL TALLER (NUEVO) -->
                    ${t.descripcion ? `<p style="color:#aaa; font-size:0.85rem; margin:8px 0 0 60px; line-height:1.4;">📝 ${t.descripcion}</p>` : ''}
                    <p style="color:#888; font-size:0.85rem; margin:2px 0;">📍 ${direccion}</p>
                    ${t.telefono ? `<p style="color:#888; font-size:0.85rem; margin:2px 0;">📞 ${t.telefono}</p>` : ''}
                    <!-- ✅ MÉTODOS DE PAGO (NUEVO) -->
                    ${metodosPagoTexto ? `<p style="color:#888; font-size:0.85rem; margin:2px 0;">💳 Acepta: ${metodosPagoTexto}</p>` : ''}
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    ${estaVinculado ? `
                    <button onclick="window.tallerManager.desvincular()" 
                        style="padding:12px 20px; background:transparent; border:1px solid #ff4444; color:#ff4444; border-radius:10px; cursor:pointer; font-weight:600; font-size:0.9rem;">
                        🔓 Desvincular
                    </button>` : `
                    <button onclick="window.vincularTallerDesdeExplorar('${tallerId}')" 
                        style="padding:12px 20px; background:#ffbb33; color:#000; border:none; border-radius:10px; cursor:pointer; font-weight:600; font-size:0.9rem;">
                        🏪 Vincular
                    </button>`}
                    <button onclick="window.agendarEnTaller('${tallerId}')" 
                        style="padding:12px 20px; background:#00ff88; color:#000; border:none; border-radius:10px; cursor:pointer; font-weight:700; font-size:0.9rem;">
                        📅 AGENDAR CITA
                    </button>
                    ${t.telefono ? `
                    <a href="https://wa.me/1${t.telefono?.replace(/[^0-9]/g, '')}" target="_blank"
                        style="padding:12px 15px; background:#25D366; color:#fff; border:none; border-radius:10px; cursor:pointer; text-decoration:none; display:flex; align-items:center; gap:6px;">
                        💬 WhatsApp
                    </a>` : ''}
                </div>
            </div>
            
            <hr style="border-color:#1e2a3a; margin:20px 0;">
            
            <!-- 🔧 Servicios -->
            <h4 style="color:#00ff88; margin-bottom:15px;">🔧 SERVICIOS (${servicios.length})</h4>
            ${servicios.length > 0 ? `
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:10px; margin-bottom:25px;">
                ${servicios.map(s => {
                    const tipoIcono = { 'LAVADO': '🧽', 'DETALLADO': '✨', 'PULIDO': '💎', 'TRATAMIENTO': '🧴', 'EXTRA': '➕' };
                    return `
                    <div style="background:#080c14; border:1px solid #1e2a3a; border-radius:10px; padding:15px; transition:all 0.2s;"
                        onmouseover="this.style.borderColor='#00ff88'" onmouseout="this.style.borderColor='#1e2a3a'">
                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
                            <span>${tipoIcono[s.tipo] || '🔧'}</span>
                            <span style="color:#fff; font-size:0.9rem;">${s.nombre}</span>
                        </div>
                        <div style="display:flex; justify-content:space-between;">
                            <span style="color:#00ff88; font-weight:600;">RD$ ${s.precio?.toLocaleString()}</span>
                            <small style="color:#888;">⏱️ ${s.duracionEstimada || 45}min</small>
                        </div>
                    </div>`;
                }).join('')}
            </div>` : '<p style="color:#888; padding:10px;">📭 No hay servicios configurados</p>'}
            
            <!-- 📦 Planes -->
            <h4 style="color:#ffbb33; margin-bottom:15px;">📦 PLANES (${planes.length})</h4>
            ${planes.length > 0 ? `
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:10px; margin-bottom:25px;">
                ${planes.map(p => {
                    const nivelIcono = { 'BASICO': '🥉', 'NORMAL': '🥈', 'PREMIUM': '🥇', 'VIP': '💎', 'PERSONALIZADO': '🔧' };
                    const nivelColor = { 'BASICO': '#00ff88', 'NORMAL': '#00d4ff', 'PREMIUM': '#ffbb33', 'VIP': '#ff44ff', 'PERSONALIZADO': '#888' };
                    const color = nivelColor[p.nivel] || '#ffbb33';
                    return `
                    <div style="background:#080c14; border:1px solid ${color}30; border-radius:12px; padding:18px; text-align:center;">
                        <span style="font-size:1.8rem;">${nivelIcono[p.nivel] || '📦'}</span>
                        <h5 style="color:#fff; margin:8px 0 4px;">${p.nombre}</h5>
                        <span style="background:${color}15; color:${color}; padding:2px 10px; border-radius:10px; font-size:0.7rem;">${p.nivel || 'NORMAL'}</span>
                        <p style="color:${color}; font-weight:700; font-size:1.1rem; margin:8px 0;">RD$ ${p.precio?.toLocaleString()}</p>
                        <small style="color:#888;">${p.serviciosIncluidos} servicios · ${p.duracionDias || 30} días</small>
                    </div>`;
                }).join('')}
            </div>` : '<p style="color:#888; padding:10px;">📭 No hay planes disponibles</p>'}
            
            <!-- ⭐ Calificaciones -->
            <div style="margin-top:20px; padding-top:20px; border-top:1px solid #1e2a3a;">
                <h4 style="color:#ffbb33; margin-bottom:15px;">⭐ Calificaciones y Reseñas</h4>
                <div id="calificaciones-content-${tallerId}">
                    <p style="color:#888; text-align:center; padding:15px;">⏳ Cargando calificaciones...</p>
                </div>
            </div>
            
            <!-- 📸 Galería -->
            <div style="margin-top:20px; padding-top:20px; border-top:1px solid #1e2a3a;">
                <h4 style="color:#00d4ff; margin-bottom:15px;">📸 Galería de Trabajos</h4>
                <div id="galeria-content-${tallerId}" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:10px;">
                    <p style="color:#888; grid-column:1/-1; text-align:center;">⏳ Cargando fotos...</p>
                </div>
            </div>
            
            <!-- 🗺️ Mapa Interactivo -->
            <div style="margin-top:20px; padding-top:20px; border-top:1px solid #1e2a3a;">
                <h4 style="color:#00d4ff; margin-bottom:15px;">🗺️ Ubicación</h4>
                <div id="mapa-taller-${tallerId}" style="width:100%; height:300px; border-radius:12px; background:#080c14; border:1px solid #1e2a3a;"></div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;">
                    <small style="color:#888;">📍 ${direccion}</small>
                    <a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccion)}" target="_blank" 
                        style="color:#00d4ff; text-decoration:none; font-size:0.8rem;">
                        🔗 Ver en Google Maps
                    </a>
                </div>
            </div>
        `;

        // Cargar calificaciones, galería y mapa
        setTimeout(() => window.resenasSocial?.cargar(tallerId, `calificaciones-content-${tallerId}`), 300);
        setTimeout(() => window.galeriaTaller?.cargar(tallerId), 300);

        // ✅ Pasar coordenadas guardadas si existen (NUEVO)
        const coordenadas = t.direccion?.coordenadas?.lat ? {
            lat: t.direccion.coordenadas.lat,
            lng: t.direccion.coordenadas.lng
        } : null;
        setTimeout(() => window.mapaTaller?.inicializar(tallerId, direccion, t.nombre, coordenadas), 500);

    } catch (error) {
        detalleContainer.innerHTML = '<p style="color:#ff4444;">Error al cargar detalles</p>';
    }
};

/**
 * Agendar cita en un taller específico
 */
window.agendarEnTaller = function (tallerId) {
    // Cerrar sección actual y abrir modal de cita
    window.abrirModalSolicitud(tallerId);
};



/**
 * Cargar galería del taller
 */
window.cargarGaleriaTaller = async function (tallerId) {
    const container = document.getElementById('galeria-taller');
    if (!container) return;

    try {
        const response = await apiFetch(`/talleres/${tallerId}/galeria`);
        const data = await response.json();

        if (data.exito && data.fotos.length > 0) {
            container.innerHTML = data.fotos.map(foto => `
                <div style="background:#080c14; border-radius:10px; overflow:hidden; cursor:pointer; height:120px;"
                    onclick="window.verFotoGrande('${foto.url}')">
                    <img src="${foto.url}" style="width:100%; height:100%; object-fit:cover;" 
                        onerror="this.parentElement.style.display='none'">
                </div>
            `).join('');
        } else {
            container.innerHTML = '<p style="color:#888; grid-column:1/-1; text-align:center; padding:20px;">📭 No hay fotos todavía</p>';
        }
    } catch (error) {
        container.innerHTML = '<p style="color:#888;">Error al cargar fotos</p>';
    }
};

/**
 * Ver foto en grande
 */
window.verFotoGrande = function (url) {
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); display:flex; align-items:center; justify-content:center; z-index:10000; cursor:zoom-out;';
    modal.innerHTML = `<img src="${url}" style="max-width:90vw; max-height:90vh; border-radius:10px;">`;
    modal.onclick = () => modal.remove();
    document.body.appendChild(modal);
};


/**
 * Vincular taller desde la vista de explorar
 */
window.vincularTallerDesdeExplorar = async function (tallerId) {
    if (window.tallerManager) {
        await window.tallerManager.vincular(tallerId);
        // Recargar las tarjetas para mostrar cuál está vinculado
        window.filtrarTalleres();
    }
};

window.buscarMiUbicacionManual = async function (tallerId, direccion, nombre, lat, lng) {
    const input = document.getElementById(`input-mi-ubicacion-${tallerId}`);
    const miDireccion = input?.value?.trim();

    if (!miDireccion) {
        window.mostrarToast?.('⚠️ Ingresa una dirección para buscar', 'warning');
        return;
    }

    if (window.mapaTaller) {
        const encontrada = await window.mapaTaller.buscarMiUbicacion(miDireccion);
        if (encontrada) {
            window.mapaTaller.inicializar(tallerId, direccion, nombre, { lat, lng });
            window.mostrarToast?.('✅ Ruta trazada desde tu ubicación', 'success');
        } else {
            window.mostrarToast?.('❌ No se encontró la dirección', 'error');
        }
    }
};
// ==================== INICIALIZACIÓN FINAL ====================
console.log('✅ Dashboard del cliente inicializado correctamente (v2.0 - Compatible con Clase Cliente)');
console.log('🔧 Mejoras: Toast notifications, Sistema de logs, Cache, Reintentos, Validaciones, Compatibilidad con #privados');