// ==================== SISTEMA DE LOGS ====================
const logger = {
    niveles: { DEBUG: 0, INFO: 1, WARN: 2, ERROR: 3 },
    nivel: 1,
    historial: [],

    log: function (nivel, mensaje, data = null) {
        if (nivel >= this.nivel) {
            const timestamp = new Date().toISOString();
            const prefijo = Object.keys(this.niveles).find(k => this.niveles[k] === nivel);
            const logEntry = { timestamp, nivel: prefijo, mensaje, data };
            this.historial.push(logEntry);

            if (this.historial.length > 100) {
                this.historial.shift();
            }

            const styles = {
                DEBUG: 'color: #888',
                INFO: 'color: #00d4ff',
                WARN: 'color: #ffbb33',
                ERROR: 'color: #ff4444'
            };

            console.log(
                `%c[${timestamp}] [${prefijo}] ${mensaje}`,
                styles[prefijo] || '',
                data || ''
            );
        }
    },

    debug: function (msg, data) { this.log(0, msg, data); },
    info: function (msg, data) { this.log(1, msg, data); },
    warn: function (msg, data) { this.log(2, msg, data); },
    error: function (msg, data) { this.log(3, msg, data); },

    obtenerHistorial: function () { return [...this.historial]; },
    exportar: function () { return JSON.stringify(this.historial, null, 2); }
};

// ==================== SISTEMA DE TOAST NOTIFICATIONS ====================
window.mostrarToast = function (mensaje, tipo = 'info', duracion = 3000) {
    const colores = {
        success: '#00ff88',
        error: '#ff4444',
        warning: '#ffbb33',
        info: '#00d4ff'
    };

    const iconos = {
        success: '✅',
        error: '❌',
        warning: '⚠️',
        info: 'ℹ️'
    };

    const toast = document.createElement('div');
    toast.className = 'toast-notification';
    toast.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: #131c2b;
        border-left: 4px solid ${colores[tipo]};
        color: white;
        padding: 15px 20px;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        z-index: 100000;
        min-width: 300px;
        max-width: 400px;
        transform: translateX(120%);
        transition: transform 0.3s ease;
        font-family: 'Inter', sans-serif;
        display: flex;
        align-items: center;
        gap: 10px;
        animation: slideIn 0.3s ease forwards, fadeOut 0.3s ease ${duracion - 300}ms forwards;
    `;

    toast.innerHTML = `
        <span style="font-size: 1.2rem;">${iconos[tipo]}</span>
        <span style="flex: 1; font-size: 0.9rem;">${mensaje}</span>
        <button onclick="this.parentElement.remove()" style="background: none; border: none; color: #888; cursor: pointer; font-size: 1.2rem;">×</button>
    `;

    if (!document.getElementById('toast-styles')) {
        const style = document.createElement('style');
        style.id = 'toast-styles';
        style.textContent = `
            @keyframes slideIn {
                to { transform: translateX(0); }
            }
            @keyframes fadeOut {
                to { opacity: 0; transform: translateX(120%); }
            }
        `;
        document.head.appendChild(style);
    }

    document.body.appendChild(toast);

    setTimeout(() => {
        if (toast.parentElement) {
            toast.remove();
        }
    }, duracion);
};

// ==================== SISTEMA DE ESTADO DE CARGA ====================
window.estadoCarga = {
    overlay: null,

    inicializar: function () {
        if (!this.overlay) {
            this.overlay = document.createElement('div');
            this.overlay.id = 'loading-overlay';
            this.overlay.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.8);
                z-index: 99999;
                display: none;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 20px;
            `;
            this.overlay.innerHTML = `
                <div class="spinner" style="
                    width: 50px;
                    height: 50px;
                    border: 3px solid #333;
                    border-top: 3px solid #00ff88;
                    border-radius: 50%;
                    animation: spin 1s linear infinite;
                "></div>
                <p style="color: #00ff88; font-family: 'Inter', sans-serif;">Procesando...</p>
            `;

            const spinnerStyle = document.createElement('style');
            spinnerStyle.textContent = `
                @keyframes spin {
                    to { transform: rotate(360deg); }
                }
            `;
            document.head.appendChild(spinnerStyle);
            document.body.appendChild(this.overlay);
        }
    },

    mostrar: function (mensaje = 'Procesando...') {
        this.inicializar();
        this.overlay.querySelector('p').textContent = mensaje;
        this.overlay.style.display = 'flex';
    },

    ocultar: function () {
        if (this.overlay) {
            this.overlay.style.display = 'none';
        }
    }
};

// ==================== SISTEMA DE CACHE ====================
const cache = new Map();

window.obtenerConCache = async function (clave, funcionFetch, ttl = CACHE_TTL) {
    const cached = cache.get(clave);

    if (cached && (Date.now() - cached.timestamp) < ttl) {
        logger.debug(`Cache hit: ${clave}`);
        return cached.data;
    }

    logger.debug(`Cache miss: ${clave}, fetching...`);

    try {
        const data = await funcionFetch();
        cache.set(clave, { data, timestamp: Date.now() });
        return data;
    } catch (error) {
        logger.error(`Error fetching ${clave}:`, error);
        if (cached) {
            logger.warn(`Usando cache expirado como fallback: ${clave}`);
            return cached.data;
        }
        throw error;
    }
};

window.limpiarCache = function () {
    cache.clear();
    logger.info('Cache limpiado');
};

// ==================== VALIDADORES ====================
const validadores = {
    placa: (placa) => /^[A-Z0-9]{5,8}$/.test(placa.toUpperCase().replace(/[-\s]/g, '')),
    telefono: (tel) => /^(809|829|849)\d{7}$/.test(tel.replace(/[-\s]/g, '')),
    email: (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email),
    fecha: (fecha) => {
        const f = new Date(fecha);
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        const maxFecha = new Date();
        maxFecha.setDate(maxFecha.getDate() + 30);
        return f >= hoy && f <= maxFecha && f.getDay() !== 0;
    }
};

// ==================== SISTEMA DE REINTENTOS ====================
window.fetchConReintento = async function (url, options = {}, maxRetries = MAX_RETRIES) {
    let ultimoError;

    for (let intento = 1; intento <= maxRetries; intento++) {
        try {
            logger.debug(`Intento ${intento}/${maxRetries} para ${url}`);
            const response = await apiFetch(url, options);

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const data = await response.json();
            return data;

        } catch (error) {
            ultimoError = error;
            logger.warn(`Intento ${intento} fallido: ${error.message}`);

            if (intento < maxRetries) {
                const delay = Math.pow(2, intento) * 1000;
                logger.debug(`Esperando ${delay}ms antes de reintentar...`);
                await new Promise(resolve => setTimeout(resolve, delay));
            }
        }
    }

    throw new Error(`Falló después de ${maxRetries} intentos: ${ultimoError.message}`);
};

// ==================== BLOQUEO DE OPERACIONES ====================
window.adquirirBloqueo = async function (clave, timeout = 5000) {
    if (window.bloqueos.has(clave)) {
        throw new Error(`Operación en progreso: ${clave}`);
    }

    window.bloqueos.set(clave, Date.now());
    logger.debug(`Bloqueo adquirido: ${clave}`);

    setTimeout(() => {
        if (window.bloqueos.has(clave)) {
            window.bloqueos.delete(clave);
            logger.warn(`Bloqueo liberado por timeout: ${clave}`);
        }
    }, timeout);

    return clave;
};

window.liberarBloqueo = function (clave) {
    window.bloqueos.delete(clave);
    logger.debug(`Bloqueo liberado: ${clave}`);
};

// ==================== FUNCIONES AUXILIARES PARA CLASE CLIENTE ====================

window.obtenerIdUsuario = function () {
    if (!window.user) return null;
    return window.user.id; // Getter de la clase Cliente
};

window.persistirUsuario = function () {
    if (!window.user) return;
    try {
        const datos = window.user.toJSON();
        localStorage.setItem('sesion_activa', JSON.stringify(datos));
    } catch (error) {
        logger.error('Error al persistir usuario:', error);
    }
};

